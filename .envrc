# direnv: load shell.nix (OpenTofu, Python + python-hcl2, git, TF_CLI_CONFIG_FILE) when you cd in.
# nix-direnv caches the environment in .direnv/ and re-evaluates only when a watched file changes.
# Run `direnv allow` once (and again after editing this file). Non-interactive: `direnv exec . tofu ...`.
# NixOS (a0-nix): shells under a long-running multiplexer (herdr/tmux) inherit the NIX_PATH from before the
# last nixos-rebuild, and /etc/profile won't refresh it (__NIXOS_SET_ENVIRONMENT_DONE). shell.nix needs the
# current one (<nixpkgs-unstable> for OpenTofu), so take it from the system's /etc/set-environment.
if [ -r /etc/set-environment ]; then
  eval "$(grep -m1 '^export NIX_PATH=' /etc/set-environment)"
fi
use nix
watch_file tooling/local-provider.generated.tfrc
