# Local providers are built per machine, so lock-file hashes are not portable.
**/.terraform.lock.hcl
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.secret.auto.tfvars
*.secret.tfvars
inventory/auto.tfvars.secret/
tooling/tests/__pycache__/
.env
.provider-build/
.tofu-provider-mirror/
crash.log
tmp/
