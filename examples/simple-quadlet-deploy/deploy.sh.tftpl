#!/bin/bash
# Generated by OpenTofu for ${host}. Installs the files below and restarts what changed.
set -euo pipefail
stage=$(mktemp -d) # 0700: staged secrets stay private
trap 'rm -rf "$stage"' EXIT

# 1. Unpack every file into the staging directory. Nothing on the host changes yet.
unpack() { mkdir -p "$stage$(dirname "$1")"; base64 -d <<<"$2" > "$stage$1"; }
%{ for f in files ~}
unpack '${f.path}' '${base64encode(f.content)}'
%{ endfor ~}

# 2. Pull the images and check the staged configs. A broken config stops the deploy here.
%{ for image in images ~}
podman pull -q '${image}' >/dev/null
%{ endfor ~}
%{ for check in checks ~}
${check}
%{ endfor ~}

# 3. Install the files that differ and note which unit each belongs to.
restart=" " reload=" "
put() { # path mode unit
  cmp -s "$stage$1" "$1" && return
  install -D -m "$2" "$stage$1" "$1"
  echo "updated $1"
  case $1 in
    /etc/containers/systemd/*) restart+="$3 " ;; # the unit itself changed (image, ports, ...)
    *) reload+="$3 " ;;                          # only its config changed
  esac
}
%{ for f in files ~}
put '${f.path}' '${f.mode}' '${f.unit}'
%{ endfor ~}

# 4. Restart, start or reload, in order. The units use Notify=healthy, so systemctl returns
#    only when the container is healthy and fails when it never gets there.
systemctl daemon-reload
for unit in ${join(" ", units)}; do
  if [[ $restart == *" $unit "* ]] || ! systemctl is-active -q "$unit"; then
    echo "restarting $unit"
    systemctl restart "$unit" || { journalctl -u "$unit" -n 25 --no-pager >&2; exit 1; }
  elif [[ $reload == *" $unit "* ]]; then
    echo "reloading $unit"
    systemctl reload-or-restart "$unit" # reload when the unit has ExecReload, else restart
  fi
done
echo "deployed ${host}: ${join(" ", units)}"
