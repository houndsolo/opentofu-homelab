[Unit]
Description=Prometheus
Wants=network-online.target
After=network-online.target

[Container]
Image=${image}
ContainerName=prometheus
PublishPort=9090:9090
# Config from the host (read-only); data in a Podman named volume, which Podman creates
# with the owner the image expects (no chown in the deploy script).
Volume=/etc/prometheus:/etc/prometheus:ro
Volume=prometheus-data:/prometheus
Exec=--config.file=/etc/prometheus/prometheus.yml --storage.tsdb.path=/prometheus --storage.tsdb.retention.time=${retention}
# With Notify=healthy, "systemctl start/restart prometheus" returns only once this passes
# (or fails after TimeoutStartSec): the deploy script needs no wait loop of its own.
HealthCmd=wget -q -O /dev/null http://127.0.0.1:9090/-/ready
HealthInterval=5s
HealthStartPeriod=2m
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=300
# "systemctl reload prometheus" re-reads prometheus.yml without a restart.
ExecReload=/usr/bin/podman kill --signal HUP prometheus

[Install]
WantedBy=multi-user.target
