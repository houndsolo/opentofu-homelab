[Unit]
Description=Grafana
Wants=network-online.target
After=network-online.target

[Container]
Image=${image}
ContainerName=grafana
Network=monitoring.network
PublishPort=3000:3000
# Secrets (GF_SECURITY_ADMIN_PASSWORD) stay in a 0600 root file; systemd reads it, not the container user.
EnvironmentFile=/etc/monitoring/grafana.env
Environment=GF_ANALYTICS_REPORTING_ENABLED=false
Volume=/etc/monitoring/grafana/provisioning:/etc/grafana/provisioning:ro
Volume=grafana-data:/var/lib/grafana
HealthCmd=curl -fsS -o /dev/null http://127.0.0.1:3000/api/health
HealthInterval=5s
HealthStartPeriod=2m
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
