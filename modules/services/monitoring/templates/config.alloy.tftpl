// Managed by OpenTofu (monitoring-config). Local edits are overwritten.
// Grafana Alloy on ${host}: the host's journal (every Quadlet container logs to
// it through Podman's journald driver)%{ if syslog } and the network syslog receiver%{ endif } -> Loki.

loki.write "loki" {
  endpoint {
    url = "${loki_url}/loki/api/v1/push"
  }
}

loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal_container_name"]
    target_label  = "container"
  }
  rule {
    source_labels = ["__journal_syslog_identifier"]
    target_label  = "app"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
}

loki.source.journal "host" {
  max_age       = "12h"
  relabel_rules = loki.relabel.journal.rules
  labels        = { host = "${host}", source = "journal" }
  forward_to    = [loki.process.journal.receiver]
}

// Journal lines, before Loki (DT-011, DT-022):
// - Mimir logs one msg="evaluation stats" line per rule-group evaluation (~265k/day, 17 % of all Loki lines):
//   dropped, counted in loki_process_dropped_lines_total{reason="mimir_evaluation_stats"}.
// - level: Podman's journald driver gives every stderr line priority err, so a container's info lines landed
//   as level="error". Lines that carry their own level (logfmt level=..., Telegraf's "I!/W!/E!/D!") get the
//   label from the line, in the journal's words (warning, error, critical). Other lines keep the journal priority.
loki.process "journal" {
  stage.match {
    selector            = "{source=\"journal\", unit=\"mimir.service\"} |= \"msg=\\\"evaluation stats\\\"\""
    action              = "drop"
    drop_counter_reason = "mimir_evaluation_stats"
  }
  stage.match {
    selector = "{source=\"journal\"} |~ \"(^|\\\\s)level=\\\"?[A-Za-z]+\""
    stage.regex {
      expression = `(?:^|\s)level="?(?P<line_level>[A-Za-z]+)`
    }
    stage.template {
      source   = "line_level"
      template = `{{ $l := ToLower .Value }}{{ if eq $l "warn" }}warning{{ else if or (eq $l "err") (eq $l "eror") }}error{{ else if or (eq $l "crit") (eq $l "fatal") (eq $l "panic") }}critical{{ else if or (eq $l "dbug") (eq $l "trace") }}debug{{ else }}{{ $l }}{{ end }}`
    }
    stage.labels {
      values = { level = "line_level" }
    }
  }
  stage.match {
    selector = "{source=\"journal\"} |~ \"^\\\\S+ [DIWE]! \""
    stage.regex {
      expression = `^\S+ (?P<line_level>[DIWE])! `
    }
    stage.template {
      source   = "line_level"
      template = `{{ if eq .Value "D" }}debug{{ else if eq .Value "I" }}info{{ else if eq .Value "W" }}warning{{ else }}error{{ end }}`
    }
    stage.labels {
      values = { level = "line_level" }
    }
  }
  // dark-triage (Werkzeug on stderr, so priority err): its access lines carry no level; set it from the HTTP
  // status (1xx-3xx info, 4xx warning, 5xx error). Its own messages start with the Python level name.
  stage.match {
    selector = "{source=\"journal\", unit=\"dark-triage.service\"} |~ \"HTTP/[0-9.]+\\\" [1-5][0-9][0-9] \""
    stage.regex {
      expression = `HTTP/[0-9.]+" (?P<line_level>[1-5])[0-9][0-9] `
    }
    stage.template {
      source   = "line_level"
      template = `{{ if eq .Value "5" }}error{{ else if eq .Value "4" }}warning{{ else }}info{{ end }}`
    }
    stage.labels {
      values = { level = "line_level" }
    }
  }
  stage.match {
    selector = "{source=\"journal\", unit=\"dark-triage.service\"} |~ \"^(DEBUG|INFO|WARNING|ERROR|CRITICAL) \""
    stage.regex {
      expression = `^(?P<line_level>DEBUG|INFO|WARNING|ERROR|CRITICAL) `
    }
    stage.template {
      source   = "line_level"
      template = `{{ ToLower .Value }}`
    }
    stage.labels {
      values = { level = "line_level" }
    }
  }
  // BIND (named -f with named.conf's stderr channel, services-config): "<category>: <severity>: message";
  // "debug 3" is debug.
  stage.match {
    selector = "{source=\"journal\", container=\"bind9\"} |~ \"^[a-z0-9-]+: (critical|error|warning|notice|info|debug)( [0-9]+)?: \""
    stage.regex {
      expression = `^[a-z0-9-]+: (?P<line_level>critical|error|warning|notice|info|debug)(?: [0-9]+)?: `
    }
    stage.labels {
      values = { level = "line_level" }
    }
  }
  forward_to = [loki.write.loki.receiver]
}
%{ if syslog ~}

// Network syslog, received on every address (the VIPs included).
//   TCP ${syslog_port}:  RFC 5424, octet-counted (VyOS, rsyslog on the PVE nodes); sender's timestamp
//   UDP ${syslog_port}:  RFC 3164 (MikroTik); no year/zone, so receive time
//   UDP ${raw_port}: raw lines, not parsed (Cisco C9800 IOS-XE and FS S3910 aren't RFC 3164, and the FS S3700
//              ends its messages with a NUL byte, which the RFC 3164 parser drops silently; switch-1 has no
//              NTP either); labels come from the sender's address only. Needs --stability.level=experimental.
loki.source.syslog "network" {
  listener {
    address                = "0.0.0.0:${syslog_port}"
    protocol               = "tcp"
    // Default 120s hangs up on quiet senders (leaves between -- MARK --s) and rsyslog
    // logs an err+warning reconnect triplet each time (DT-013). 1h > the 20 min MARK interval.
    idle_timeout           = "1h"
    syslog_format          = "rfc5424"
    use_incoming_timestamp = true
    labels                 = { source = "syslog" }
  }
  listener {
    address                = "0.0.0.0:${syslog_port}"
    protocol               = "udp"
    syslog_format          = "rfc3164"
    use_incoming_timestamp = false
    labels                 = { source = "syslog" }
  }
  listener {
    address                = "0.0.0.0:${raw_port}"
    protocol               = "udp"
    syslog_format          = "raw"
    use_incoming_timestamp = false
    labels                 = { source = "syslog" }
  }
  relabel_rules = loki.relabel.syslog.rules
  forward_to    = [%{ if dedup_hosts != "" }loki.process.syslog.receiver%{ else }loki.write.loki.receiver%{ endif }]
}
%{ if dedup_hosts != "" ~}

// VyOS sends every non-kernel line twice: its rsyslog reads the journal (imjournal) and
// journald's syslog socket (imuxsock, ForwardToSyslog=yes). The imuxsock copy is the
// message with one space in front. Dropped here for the hosts matching dedup_hosts: lines
// with exactly one leading space, then a non-space. Kernel lines only come through
// imjournal. Indented continuation lines (tracebacks) keep both copies. A line that only
// came through imjournal and starts with one space is lost: boot-time lines from before
// rsyslog started (~100 per reboot) and the odd line imjournal missed, ~125/day over the
// 14 VyOS routers in the 2026-11-10 check. The PVE nodes (rsyslog, one copy with a
// leading space on every line) and the switches aren't matched. Dropped lines:
// loki_process_dropped_lines_total{reason="vyos_imuxsock_duplicate"}.
loki.process "syslog" {
  stage.match {
    selector            = "{host=~\"${replace(dedup_hosts, "\\", "\\\\\\\\")}\", app!=\"kernel\"} |~ \"^ [^ ]\""
    action              = "drop"
    drop_counter_reason = "vyos_imuxsock_duplicate"
  }
  // Kea's HA partners send each other an ha-heartbeat every few seconds and kea-dhcp4 logs each one (~98 % of
  // its lines, DT-037). Real HA trouble still shows: HA_HEARTBEAT_COMMUNICATIONS_FAILED, HA_STATE_TRANSITION.
  stage.match {
    selector            = "{app=\"kea-dhcp4\"} |= \"Received command 'ha-heartbeat'\""
    action              = "drop"
    drop_counter_reason = "kea_ha_heartbeat"
  }
  // Kea (kea-dhcp4, fw-wan's kea-vrf-helper) sends every line at syslog priority info and puts its own severity
  // in the text ("WARN  HA_...", some lines with a date first). WARN/ERROR/FATAL/DEBUG set the level label
  // (warning, error, critical, debug: DT-011); INFO keeps syslog's "informational" like every other syslog line.
  stage.match {
    selector = "{app=~\"kea.*\"} |~ \"^([0-9-]+ [0-9:.]+ )?(FATAL|ERROR|WARN|DEBUG) \""
    stage.regex {
      expression = `^(?:[0-9-]+ [0-9:.]+ )?(?P<kea_level>FATAL|ERROR|WARN|DEBUG) `
    }
    stage.template {
      source   = "kea_level"
      template = `{{ if eq .Value "FATAL" }}critical{{ else if eq .Value "WARN" }}warning{{ else }}{{ ToLower .Value }}{{ end }}`
    }
    stage.labels {
      values = { level = "kea_level" }
    }
  }
  forward_to = [loki.write.loki.receiver]
}
%{ endif ~}

loki.relabel "syslog" {
  forward_to = []

  rule {
    source_labels = ["__syslog_message_hostname"]
    target_label  = "host"
  }
  // No hostname in the message: use the sender's address (then the known senders' names below).
  rule {
    source_labels = ["__syslog_message_hostname", "__syslog_connection_ip_address"]
    regex         = ";(.+)"
    target_label  = "host"
  }
%{ for ip in sort(keys(host_overrides)) ~}
  rule {
    source_labels = ["__syslog_connection_ip_address"]
    regex         = "${replace(ip, ".", "\\\\.")}"
    target_label  = "host"
    replacement   = "${host_overrides[ip]}"
  }
%{ endfor ~}
  rule {
    source_labels = ["__syslog_message_app_name"]
    target_label  = "app"
  }
  rule {
    source_labels = ["__syslog_message_severity"]
    target_label  = "level"
  }
  rule {
    source_labels = ["__syslog_message_facility"]
    target_label  = "facility"
  }
}
%{ endif ~}
