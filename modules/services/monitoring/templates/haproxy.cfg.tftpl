# Managed by OpenTofu (monitoring-config). Local edits are overwritten.
# S3 for ${client} on ${host}: 127.0.0.1:7480 -> the Ceph RGWs on the PVE nodes (Ceph public
# network). Any single RGW (or PVE node) can go down without ${client} noticing.

global
  maxconn 2000

defaults
  mode http
  timeout connect 3s
  timeout client 5m
  timeout server 5m
  retries 2
  option redispatch

frontend s3
  bind 127.0.0.1:7480
  default_backend rgw

backend rgw
  balance roundrobin
  # HEAD / returns 200 with no body, so haproxy closes cleanly and RGW doesn't
  # log "complete_request() returned Connection reset by peer" (DT-028).
  option httpchk
  http-check send meth HEAD uri / ver HTTP/1.1 hdr Host rgw
  http-check expect status 200
  default-server check inter 15s fall 3 rise 2
%{ for i, endpoint in endpoints ~}
  server rgw${i + 1} ${endpoint}
%{ endfor ~}

# Prometheus metrics (job haproxy) and the stats page, on the backend VLAN.
frontend stats
  bind ${stats_address}:8405
  http-request use-service prometheus-exporter if { path /metrics }
  stats enable
  stats uri /stats
  stats refresh 10s
