# Managed by OpenTofu (monitoring-config). Local edits are overwritten.
# VRRP for the monitoring backend VIPs on ${host}. One instance: adverts go unicast over
# the HA VLAN (${ha_interface}), and the VIPs sit on the client-facing NICs, so they move together.

global_defs {
  router_id ${host}
  script_user nobody nogroup
  enable_script_security
  vrrp_garp_master_refresh 60
}

# No weight: a failing check puts the node in FAULT, which releases the VIPs. (With
# nopreempt a lowered priority would never move them.)
%{ if check_telegraf ~}
# The WLC Telegraf (C9800 telemetry on the monitoring VIP): its own metrics endpoint. No init_fail:
# added by a reload, an init_fail script would start FAILED on both backends at once and drop the
# VIPs until it rises; a fresh keepalived still only takes the VIPs after chk_alertmanager rises.
vrrp_script chk_telegraf {
  script "/usr/bin/curl -fsS -m 2 -o /dev/null http://${backend_address}:9273/metrics"
  interval 5
  timeout 3
  fall 3
  rise 2
}

%{ endif ~}
vrrp_script chk_alertmanager {
  script "/usr/bin/curl -fsS -m 2 -o /dev/null http://${backend_address}:9093/-/ready"
  interval 5
  timeout 3
  fall 3
  rise 2
  init_fail
}

vrrp_instance monitoring {
  # Everyone starts BACKUP and nobody preempts: priority only decides the first election,
  # and a recovered node doesn't pull the VIPs back (no second interruption).
  state BACKUP
  nopreempt
  interface ${ha_interface}
  virtual_router_id ${router_id}
  priority ${priority}
  advert_int 1
  unicast_src_ip ${ha_address}
  unicast_peer {
%{ for peer in peers ~}
    ${peer}
%{ endfor ~}
  }
  authentication {
    auth_type PASS
    auth_pass ${auth_pass}
  }
  # use_vmac: each VIP sits on a macvlan with the VRRP virtual MAC 00:00:5e:00:01:<VRID>, so its MAC
  # never changes on failover (with ARP suppression the new MASTER's gratuitous ARP doesn't reach
  # same-VLAN hosts, DT-045); only its EVPN location moves. Adverts stay on the HA L2VNI.
  virtual_ipaddress {
%{ for vip in vips ~}
    ${vip.cidr} dev ${vip.interface} use_vmac
%{ endfor ~}
  }
  # A client NIC going down is a FAULT too: its VIP would be unreachable here.
  track_interface {
%{ for nic in distinct([for vip in vips : vip.interface]) ~}
    ${nic}
%{ endfor ~}
  }
  track_script {
%{ if check_telegraf ~}
    chk_telegraf
%{ endif ~}
    chk_alertmanager
  }
}
