#!/bin/bash
# Managed by OpenTofu (monitoring-config). Local edits are overwritten.
# Installs the Patroni members' Debian packages: missing ones, and pinned ones outside their pin
# (software-versions.auto.tfvars) at the newest apt version matching it. The deploy runs the staged copy
# before it checks the staged configs: pg-packages <staging dir> (the PGDG apt source, pin and key are
# installed from there first). Without an argument the installed apt files are used as they are.
set -euo pipefail
stage=$${1:-}

# shellcheck source=/dev/null
codename=$(. /etc/os-release && echo "$VERSION_CODENAME")
[ "$codename-pgdg" = '${suite}' ] || { echo "PGDG suite ${suite} does not match Debian $codename" >&2; exit 1; }

# The PGDG source/pin/key first (apt lists refreshed when they change), so postgresql-<major> and the
# upgrades come from PGDG.
apt_changed=0
for f in ${join(" ", apt_files)}; do
  cmp -s "$stage$f" "$f" && continue
  install -d -m 0755 "$(dirname "$f")"
  install -m 0644 "$stage$f" "$f"
  apt_changed=1
  echo "updated $f"
done
if [ $apt_changed = 1 ]; then apt-get update -q >/dev/null; echo "apt lists updated (PGDG)"; fi

missing=""
for pkg in ${join(" ", packages)}; do
  dpkg-query -W -f='$${Status}' "$pkg" 2>/dev/null | grep -q "install ok installed" || missing+=" $pkg"
done
# Installed, but outside its pinned version: installed again at the pin below.
for spec in ${join(" ", [for pkg, pattern in versions : "'${pkg}=${pattern}'"])}; do
  pkg=$${spec%%=*}
  v=$(dpkg-query -W -f='$${Status} $${Version}' "$pkg" 2>/dev/null) || continue
  case $v in "install ok installed "*) v=$${v##* } ;; *) continue ;; esac
  # shellcheck disable=SC2254 # the series is a glob
  case $v in $${spec#*=}) ;; *) case " $missing " in *" $pkg "*) ;; *) missing+=" $pkg" ;; esac ;; esac
done
[ -n "$missing" ] || exit 0

export DEBIAN_FRONTEND=noninteractive
# Package scripts start or restart no service meanwhile (an upgraded patroni would restart with the old
# config): the services start later in the deploy, once their config is installed.
policy_rc=""
if [ ! -e /usr/sbin/policy-rc.d ]; then
  policy_rc=/usr/sbin/policy-rc.d
  printf '#!/bin/sh\nexit 101\n' > "$policy_rc"
  chmod 0755 "$policy_rc"
fi
apt_opts="-o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold"
# A pinned package installs exactly the newest apt version matching its pattern (pkg=<version>), not
# whatever the candidate is; unpinned ones take the candidate.
pattern_of() {
  case $1 in
%{ for pkg, pattern in versions ~}
    '${pkg}') echo '${pattern}' ;;
%{ endfor ~}
    *) return 1 ;;
  esac
}
resolve() { # newest apt version of $1 matching the dpkg glob $2
  apt-cache madison "$1" 2>/dev/null | awk -F'|' '{ gsub(/ /, "", $2); print $2 }' |
    while read -r v; do
      # shellcheck disable=SC2254 # the pattern is a glob
      case $v in $2) echo "$v"; break ;; esac
    done
}
targets=""
updated=""
for pkg in $missing; do
  if pat=$(pattern_of "$pkg"); then
    ver=$(resolve "$pkg" "$pat")
    if [ -z "$ver" ] && [ -z "$updated" ]; then apt-get update -q >/dev/null; updated=1; ver=$(resolve "$pkg" "$pat"); fi
    [ -n "$ver" ] || { [ -z "$policy_rc" ] || rm -f "$policy_rc"; echo "no $pkg version matching $pat in apt (software-versions.auto.tfvars)" >&2; exit 1; }
    targets+=" $pkg=$ver"
  else
    targets+=" $pkg"
  fi
done
apt_rc=0
# shellcheck disable=SC2086
apt-get install -y -q --no-install-recommends $apt_opts $targets >/dev/null ||
  { apt-get update -q >/dev/null && apt-get install -y -q --no-install-recommends $apt_opts $targets >/dev/null; } || apt_rc=$?
if [ -n "$policy_rc" ]; then rm -f "$policy_rc"; fi
[ "$apt_rc" = 0 ] || { echo "apt-get install failed ($apt_rc):$targets" >&2; exit "$apt_rc"; }
echo "installed or upgraded packages:$targets"
