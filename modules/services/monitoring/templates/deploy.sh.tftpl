#!/bin/bash
# Generated by OpenTofu (monitoring-config) for ${host}.
#   deploy.sh check   pull images, validate configs, list files that would change; installs nothing
#   deploy.sh deploy  (default) the above (installing any Debian packages first), then install
#                     files and (re)start the services
set -euo pipefail
umask 077
mode=$${1:-deploy}
case $mode in deploy|check) ;; *) echo "usage: $0 [deploy|check]" >&2; exit 2 ;; esac
command -v podman >/dev/null || { echo "podman is missing" >&2; exit 1; }
stage=$(mktemp -d /tmp/tofu-monitoring.XXXXXX)
trap 'rm -rf "$stage"' EXIT
root="$stage/root"

unpack() { install -d "$root$(dirname "$1")"; printf '%s' "$2" | base64 -d > "$root$1"; }
%{ for f in files ~}
unpack '${f.path}' '${base64encode(f.content)}'
%{ endfor ~}

%{ for image in images ~}
podman pull -q '${image}' >/dev/null
%{ endfor ~}
echo "images present: ${length(images)}"
%{ if length(packages) > 0 ~}

# Debian packages: installed in deploy mode only (check mode installs nothing).
missing=""
for pkg in ${join(" ", packages)}; do
  dpkg-query -W -f='$${Status}' "$pkg" 2>/dev/null | grep -q "install ok installed" || missing+=" $pkg"
done
if [ -n "$missing" ]; then
  if [ "$mode" = check ]; then
    echo "would install packages:$missing"
  else
    export DEBIAN_FRONTEND=noninteractive
    apt-get install -y -q --no-install-recommends $missing >/dev/null ||
      { apt-get update -q >/dev/null && apt-get install -y -q --no-install-recommends $missing >/dev/null; }
    echo "installed packages:$missing"
  fi
fi
%{ endif ~}

# Validate in throwaway containers without network before anything is installed.
%{ for validation in validations ~}
${validation}
%{ endfor ~}

declare -A owner_cache=()
# "root" -> 0:0; "runtime|IMAGE" -> uid:gid of the user IMAGE runs as;
# "user|IMAGE|NAME" -> uid:gid of user NAME inside IMAGE (for images that start
# as root and drop to a service user, like postgres and influxdb).
owner_ids() {
  local spec=$1 image user u
  [ "$spec" != root ] || { echo 0:0; return; }
  if [ "$${spec%%|*}" = user ]; then
    if [ -z "$${owner_cache[$spec]:-}" ]; then
      image=$${spec#user|}; image=$${image%|*}; u=$${spec##*|}
      owner_cache[$spec]="$(podman run --rm --network=none --entrypoint id "$image" -u "$u"):$(podman run --rm --network=none --entrypoint id "$image" -g "$u")"
    fi
    echo "$${owner_cache[$spec]}"
    return
  fi
  image=$${spec#runtime|}
  if [ -z "$${owner_cache[$image]:-}" ]; then
    user=$(podman image inspect --format '{{.Config.User}}' "$image")
    case $user in
      '') owner_cache[$image]=0:0 ;;
      *[!0-9:]*)
        u=$${user%%:*}
        owner_cache[$image]="$(podman run --rm --network=none --entrypoint id "$image" -u "$u"):$(podman run --rm --network=none --entrypoint id "$image" -g "$u")" ;;
      *:*) owner_cache[$image]=$user ;;
      *) owner_cache[$image]="$user:$user" ;;
    esac
  fi
  echo "$${owner_cache[$image]}"
}

differs() { # path mode owner-spec
  local ids
  [ -e "$1" ] || return 0
  cmp -s "$root$1" "$1" || return 0
  ids=$(owner_ids "$3")
  [ "$(stat -c '%a %u:%g' "$1")" = "$${2#0} $ids" ] && return 1 || return 0
}

in_list() { case " $2 " in *" $1 "*) return 0 ;; esac; return 1; }

# Files under these directories that this deployment doesn't install are removed.
managed='${join(" ", [for f in files : f.path])}'
prune() { # dir
  local f
  [ -d "$1" ] || return 0
  while IFS= read -r -d '' f; do
    in_list "$f" "$managed" && continue
    if [ "$mode" = check ]; then echo "would remove $f"; else rm -f "$f"; echo "removed $f"; fi
  done < <(find "$1" -type f -print0)
  [ "$mode" = check ] || find "$1" -mindepth 1 -type d -empty -delete
}

if [ "$mode" = check ]; then
%{ for d in prune_dirs ~}
  prune '${d}'
%{ endfor ~}
%{ for f in files ~}
  if differs '${f.path}' '${f.mode}' '${f.owner}'; then echo "would update ${f.path}"; fi
%{ endfor ~}
  echo "check passed for ${host}: images present, configs valid, nothing installed"
  exit 0
fi

ensure_dir() { # path mode owner-spec
  local ids
  ids=$(owner_ids "$3")
  [ -d "$1" ] || mkdir -p "$1"
  chmod "$2" "$1"
  chown "$ids" "$1"
}
%{ for d in dirs ~}
ensure_dir '${d.path}' '${d.mode}' '${d.owner}'
%{ endfor ~}

restart_units=" "
reload_units=" "
put() { # path mode owner-spec restart-units reload-units
  local ids
  differs "$1" "$2" "$3" || return 0
  ids=$(owner_ids "$3")
  install -m "$2" -o "$${ids%%:*}" -g "$${ids##*:}" "$root$1" "$1"
  restart_units+="$4 "
  reload_units+="$5 "
  echo "updated $1"
}
%{ for f in files ~}
put '${f.path}' '${f.mode}' '${f.owner}' '${join(" ", f.restart)}' '${join(" ", f.reload)}'
%{ endfor ~}

%{ for d in prune_dirs ~}
prune '${d}'
%{ endfor ~}

# Stop and remove Quadlet units this deployment used to manage but no longer does.
state='${state_file}'
wanted='${join(" ", [for f in files : basename(f.path) if dirname(f.path) == "/etc/containers/systemd"])}'
if [ -f "$state" ]; then
  while read -r quadlet; do
    [ -n "$quadlet" ] || continue
    in_list "$quadlet" "$wanted" && continue
    svc=$${quadlet%.*}
    [ "$${quadlet##*.}" != network ] || svc="$svc-network"
    systemctl stop "$svc.service" 2>/dev/null || true
    rm -f "/etc/containers/systemd/$quadlet"
    echo "removed $quadlet"
  done < "$state"
fi
printf '%s\n' $wanted > "$state"

systemctl daemon-reload
%{ for command in post_install ~}
${command}
%{ endfor ~}
for svc in ${join(" ", services)}; do
  if in_list "$svc" "$restart_units"; then
    echo "restarting $svc"; systemctl restart "$svc.service"
  elif ! systemctl is-active --quiet "$svc.service"; then
    echo "starting $svc"; systemctl start "$svc.service"
  elif in_list "$svc" "$reload_units"; then
    echo "reloading $svc"; systemctl reload "$svc.service"
  fi
done

wait_for() { # shell command; up to 2 minutes
  local i
  for i in $(seq 1 60); do
    if eval "$1" >/dev/null 2>&1; then return 0; fi
    sleep 2
  done
  echo "health check failed: $1" >&2
  return 1
}
failed=""
for svc in ${join(" ", services)}; do
  systemctl is-active --quiet "$svc.service" || failed+=" $svc"
done
%{ for check in health ~}
wait_for '${check}' || failed+=" [${check}]"
%{ endfor ~}
for svc in ${join(" ", services)}; do
  systemctl is-active --quiet "$svc.service" || in_list "$svc" "$failed" || failed+=" $svc"
done
if [ -n "$failed" ]; then
  echo "not healthy on ${host}:$failed" >&2
  for svc in ${join(" ", services)}; do
    systemctl is-active --quiet "$svc.service" || journalctl -u "$svc.service" -n 25 --no-pager >&2 || true
  done
  exit 1
fi
echo "deployed ${host}: ${join(" ", services)}"
