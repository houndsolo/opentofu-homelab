# Managed by OpenTofu (monitoring-config). Local edits are overwritten.
[Unit]
Description=haproxy: S3 (TLS) on 127.0.0.1:7443 -> Ceph RGWs
Wants=network-online.target
After=network-online.target

[Container]
Image=${image}
ContainerName=haproxy
Network=host
Volume=/etc/postgres-ha/haproxy:/usr/local/etc/haproxy:ro
Volume=/etc/ssl/certs/ssl-cert-snakeoil.pem:/usr/local/etc/haproxy/tls/s3.pem:ro
Volume=/etc/ssl/private/ssl-cert-snakeoil.key:/usr/local/etc/haproxy/tls/s3.pem.key:ro
User=0

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
