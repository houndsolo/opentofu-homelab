# Managed by OpenTofu (monitoring-config). Local edits are overwritten.
[Unit]
Description=Prometheus node exporter
Wants=network-online.target
After=network-online.target

[Container]
Image=${image}
ContainerName=node-exporter
Network=host
Volume=/:/host:ro,rslave
Volume=/run/dbus/system_bus_socket:/var/run/dbus/system_bus_socket:ro
PodmanArgs=--pid=host
Exec=--path.rootfs=/host --web.listen-address=${listen_address}:9100 --collector.netdev.address-info%{ if textfile_dir != null } --collector.textfile.directory=/host${textfile_dir}%{ endif } --collector.processes --collector.tcpstat --collector.interrupts --collector.systemd --collector.systemd.unit-include=.+[.](service|socket|timer)

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
