# Managed by OpenTofu (monitoring-config). Local edits are overwritten.
# VRRP for the logging VIPs on ${host}. One instance: adverts go unicast over the HA
# VLAN (${ha_interface}), and the VIPs sit on the client-facing NICs, so they always move together.

global_defs {
  router_id ${host}
  script_user nobody nogroup
  enable_script_security
  vrrp_garp_master_refresh 60
  vrrp_version 3 # adverts over IPv6 on the HA segment (VRRPv3: no PASS auth)
}

# No weight: a failing check puts the node in FAULT, which releases the VIPs. (With
# nopreempt a lowered priority would never move them.)
vrrp_script chk_loki {
  script "/usr/bin/curl -fsS -m 2 -o /dev/null http://127.0.0.1:3100/ready"
  interval 5
  timeout 3
  fall 3
  rise 2
  init_fail
}

vrrp_script chk_alloy {
  script "/usr/bin/curl -fsS -m 2 -o /dev/null http://${alloy_address}:12345/-/ready"
  interval 5
  timeout 3
  fall 3
  rise 2
  init_fail
}

vrrp_instance logging {
  # Everyone starts BACKUP and nobody preempts: priority only decides the first election,
  # and a recovered node doesn't pull the VIPs back (no second interruption).
  state BACKUP
  nopreempt
  interface ${ha_interface}
  virtual_router_id ${router_id}
  priority ${priority}
  advert_int 1
  unicast_src_ip ${format("fd69:50%02d::%s", tonumber(split(".", ha_address)[2]), split(".", ha_address)[3])}
  unicast_peer {
%{ for peer in peers ~}
    ${format("fd69:50%02d::%s", tonumber(split(".", peer)[2]), split(".", peer)[3])}
%{ endfor ~}
  }
  # use_vmac: each VIP sits on a macvlan with the VRRP virtual MAC 00:00:5e:00:01:<VRID>, so its MAC
  # never changes on failover (with ARP suppression the new MASTER's gratuitous ARP doesn't reach
  # same-VLAN hosts, DT-045); only its EVPN location moves. Adverts stay on the HA L2VNI.
  # IPv6 instance (VRRPv3): the advertised address is fd69:50aa::<VRID> on the HA segment (VRID = the VIP's
  # host octet), no client uses it; the real VIPs below move with the state but aren't in the adverts.
  virtual_ipaddress {
    ${format("fd69:50%02d::%d/64", tonumber(split(".", ha_address)[2]), router_id)} dev ${ha_interface}
  }
  virtual_ipaddress_excluded {
%{ for vip in vips ~}
    ${vip.cidr} dev ${vip.interface} use_vmac
%{ endfor ~}
  }
  # A client NIC going down is a FAULT too: its VIP would be unreachable here.
  track_interface {
%{ for nic in distinct([for vip in vips : vip.interface]) ~}
    ${nic}
%{ endfor ~}
  }
  track_script {
    chk_loki
    chk_alloy
  }
}
