        "definition": "query_result(label_join(count by (ifIndex, ifName, ifAlias) (ifHCInOctets{job=~\"snmp-fs-switches|snmp-mikrotik-access|snmp-spines|snmp-wlc|snmp-mikrotik-hr\",host=~\"${device:regex}\"}), \"display\", \" · \", \"ifName\", \"ifAlias\"))",
        "query": {
          "query": "query_result(label_join(count by (ifIndex, ifName, ifAlias) (ifHCInOctets{job=~\"snmp-fs-switches|snmp-mikrotik-access|snmp-spines|snmp-wlc|snmp-mikrotik-hr\",host=~\"${device:regex}\"}), \"display\", \" · \", \"ifName\", \"ifAlias\"))",
