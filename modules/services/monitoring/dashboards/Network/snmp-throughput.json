        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "-(rate(ifHCOutOctets{job=~\"snmp-fs-switches|snmp-mikrotik-access|snmp-spines|snmp-wlc|snmp-mikrotik-hr\",host=~\"${device:regex}\",ifIndex=~\"${interface:regex}\"}[$__rate_interval]) * 8)",
