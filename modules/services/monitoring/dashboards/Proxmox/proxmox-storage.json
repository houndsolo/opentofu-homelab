    {
      "type": "stat",
      "title": "Storages",
      "description": "Storages reporting now (shared ones once), the ones that reported earlier in the time range but not in the last 2 minutes (went inactive, node down or storage removed), and the fullest one. PVE sends only active storages to the metric server, so a storage that was never active in the range (an unreachable PBS, say) is not counted: `pvesm status` lists those.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "import \"date\"\nquiet = from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"system\" and r.object == \"storages\" and r.host =~ /^${storage:regex}$/ and r._field == \"shared\")\n  |> last()\n  |> group()\n  |> map(fn: (r) => ({storage: if r._value == 1.0 then r.host else r.host + \" (\" + r.nodename + \")\", t: int(v: r._time)}))\n  |> group(columns: [\"storage\"])\n  |> max(column: \"t\")\n  |> group()\n  |> reduce(identity: {n: 0}, fn: (r, accumulator) => ({\n       n: accumulator.n + (if r.t < int(v: date.sub(d: 2m, from: v.timeRangeStop)) then 1 else 0)}))\n  |> findRecord(fn: (key) => true, idx: 0)\nnums = from(bucket: \"${bucket}\")\n  |> range(start: date.sub(d: 2m, from: v.timeRangeStop), stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"system\" and r.object == \"storages\" and r.host =~ /^${storage:regex}$/ and\n       (r._field == \"total\" or r._field == \"used\" or r._field == \"avail\" or r._field == \"shared\" or r._field == \"active\" or r._field == \"enabled\"))\n  |> last()\n  |> group()\n  |> pivot(rowKey: [\"host\", \"nodename\"], columnKey: [\"_field\"], valueColumn: \"_value\")\nstrs = from(bucket: \"${bucket}\")\n  |> range(start: date.sub(d: 2m, from: v.timeRangeStop), stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"system\" and r.object == \"storages\" and r.host =~ /^${storage:regex}$/ and (r._field == \"type\" or r._field == \"content\"))\n  |> last()\n  |> group()\n  |> pivot(rowKey: [\"host\", \"nodename\"], columnKey: [\"_field\"], valueColumn: \"_value\")\njoin(tables: {n: nums, s: strs}, on: [\"host\", \"nodename\"])\n  |> map(fn: (r) => ({r with storage: if r.shared == 1.0 then r.host else r.host + \" (\" + r.nodename + \")\",\n       pct: if r.total > 0.0 then r.used / r.total else 0.0}))\n  |> group(columns: [\"storage\"])\n  |> first(column: \"storage\")\n  |> group()\n  |> sort(columns: [\"pct\"], desc: true)\n|> reduce(identity: {storages: 0, fullest: 0.0}, fn: (r, accumulator) => ({\n     storages: accumulator.storages + 1,\n     fullest: if r.pct > accumulator.fullest then r.pct else accumulator.fullest}))\n|> map(fn: (r) => ({r with quiet: if exists quiet.n then quiet.n else 0}))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
