        "definition": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"${bucket}\", tag: \"host\",\n  predicate: (r) => r._measurement == \"system\" and r.object == \"storages\",\n  start: v.timeRangeStart, stop: v.timeRangeStop)",
