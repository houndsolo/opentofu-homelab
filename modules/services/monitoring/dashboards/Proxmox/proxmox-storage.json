    {
      "type": "table",
      "title": "Storages",
      "description": "Now, shared storages once. Growth is the change of used space over the time range, per day; Full in extrapolates it (\"not filling up\" when not growing). Click a storage: Ceph storages open the Ceph cluster dashboard, local ones their node.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "import \"date\"\ncur = from(bucket: \"${bucket}\")\n  |> range(start: date.sub(d: 2m, from: v.timeRangeStop), stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"system\" and r.object == \"storages\" and r.host =~ /^${storage:regex}$/ and\n       (r._field == \"total\" or r._field == \"used\" or r._field == \"avail\" or r._field == \"shared\" or r._field == \"active\" or r._field == \"enabled\"))\n  |> last()\n  |> group()\n  |> pivot(rowKey: [\"host\", \"nodename\"], columnKey: [\"_field\"], valueColumn: \"_value\")\nstrs = from(bucket: \"${bucket}\")\n  |> range(start: date.sub(d: 2m, from: v.timeRangeStop), stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"system\" and r.object == \"storages\" and r.host =~ /^${storage:regex}$/ and (r._field == \"type\" or r._field == \"content\"))\n  |> last()\n  |> group()\n  |> pivot(rowKey: [\"host\", \"nodename\"], columnKey: [\"_field\"], valueColumn: \"_value\")\nused = from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"system\" and r.object == \"storages\" and r.host =~ /^${storage:regex}$/ and r._field == \"used\")\ngrowth = join(tables: {f: used |> first(), l: used |> last()}, on: [\"host\", \"nodename\"])\n  |> map(fn: (r) => ({host: r.host, nodename: r.nodename,\n       rate: if r._time_l > r._time_f then (r._value_l - r._value_f) / (float(v: int(v: r._time_l) - int(v: r._time_f)) / 1000000000.0) else 0.0}))\njoin(tables: {a: join(tables: {n: cur, s: strs}, on: [\"host\", \"nodename\"]), g: growth}, on: [\"host\", \"nodename\"])\n  |> map(fn: (r) => ({\n       storage: if r.shared == 1.0 then r.host else r.host + \" (\" + r.nodename + \")\",\n       nodename: if r.shared == 1.0 then \"all\" else r.nodename,\n       type: r.type, content: r.content, shared: r.shared, active: r.active, enabled: r.enabled,\n       used: r.used, avail: r.avail, total: r.total, pct: if r.total > 0.0 then r.used / r.total else 0.0,\n       day: r.rate * 86400.0,\n       full: if r.rate > 0.0 then r.avail / r.rate else -1.0,\n       link: if r.type == \"rbd\" or r.type == \"cephfs\" then \"/d/ceph-cluster/ceph-cluster?orgId=1\"\n             else if r.shared == 1.0 then \"/d/proxmox-storage/proxmox-storage?var-bucket=${bucket}&var-storage=\" + r.host\n             else \"/d/proxmox-node/proxmox-node?var-bucket=${bucket}&var-node=\" + r.nodename}))\n  |> group(columns: [\"storage\"])\n  |> first(column: \"storage\")\n  |> group()\n  |> sort(columns: [\"pct\"], desc: true)",
          "refId": "A"
        }
      ],
