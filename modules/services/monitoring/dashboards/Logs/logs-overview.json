    {
      "type": "timeseries",
      "title": "Lines by source",
      "description": "syslog: devices and VMs sending syslog; journal: the monitoring and logging VMs' journals (Alloy). The VyOS routers and DHCP VMs send every line twice; Alloy keeps one copy, so their volume is doubled only before that change (2026-11).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (source) (count_over_time({source=~\"${source}\", host=~\"(?i)$host\", app=~\"$app\"} |~ `(?i)$search` | regexp `(?:\\blevel=\"?|\\blvl=|^\\[|\\] |^\\d{4}-\\d\\d-\\d\\dT\\S+Z\\s+)(?P<lvl_>[A-Za-z]+)` | label_format level=`{{ $l := lower (or (and .container .lvl_) .level) }}{{ if eq $l \"error\" \"err\" \"eror\" \"e\" \"crit\" \"critical\" \"alert\" \"emerg\" \"emergency\" \"fatal\" \"panic\" }}error{{ else if eq $l \"warning\" \"warn\" \"w\" }}warning{{ else if eq $l \"notice\" }}notice{{ else if eq $l \"debug\" \"trace\" \"d\" }}debug{{ else }}info{{ end }}` | drop lvl_ | level=~\"$level\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#02E5A8",
                "value": null
              }
            ]
          },
          "mappings": [],
          "decimals": 0,
          "noValue": "Nothing in range",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear",
            "stacking": {
              "mode": "normal",
