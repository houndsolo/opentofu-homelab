#!/bin/bash
# Generated by OpenTofu (${name}) for ${host}. Installs the files below and restarts what changed.
set -euo pipefail
umask 022
stage=$(mktemp -d) # 0700: staged secrets stay private
trap 'rm -rf "$stage"' EXIT
retry() { # command...; up to 2 minutes
  for _ in $(seq 1 60); do "$@" >/dev/null 2>&1 && return 0; sleep 2; done
  echo "failed after 2 minutes: $*" >&2
  return 1
}

# 1. Host setup and packages.
%{ for command in setup ~}
${command}
%{ endfor ~}
%{ for pkg in packages ~}
dpkg-query -W -f='$${Status}' '${pkg}' 2>/dev/null | grep -q 'install ok installed' ||
  { apt-get update -q >/dev/null; DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends '${pkg}' >/dev/null; echo "installed ${pkg}"; }
%{ endfor ~}

# 2. Unpack every file into the staging directory. Nothing below /etc changes yet.
unpack() { mkdir -p "$stage$(dirname "$1")"; base64 -d <<<"$2" > "$stage$1"; }
%{ for f in files ~}
unpack '${f.path}' '${base64encode(f.content)}'
%{ endfor ~}

# 3. Pull the images and check the staged configs. A broken config stops the deploy here.
%{ for image in images ~}
podman image exists '${image}' || podman pull -q '${image}' >/dev/null
%{ endfor ~}
%{ for check in checks ~}
${check}
%{ endfor ~}
%{ for command in pre_install ~}
${command}
%{ endfor ~}

# 4. Install the files that differ and note which units they belong to.
%{ for d in dirs ~}
install -d -m '${d.mode}' -o '${split(":", d.owner)[0]}' -g '${split(":", d.owner)[1]}' '${d.path}'
%{ endfor ~}
restart=" " reload=" "
put() { # path mode owner restart|reload|once units...
  local path=$1 mode=$2 owner=$3 action=$4
  shift 4
  if [ "$action" = once ] && [ -e "$path" ]; then return 0; fi
  if ! cmp -s "$stage$path" "$path"; then
    install -D -m "$mode" "$stage$path" "$path"
    echo "updated $path"
    if [ "$action" = restart ]; then restart+="$* "; else reload+="$* "; fi
  fi
  chown "$owner" "$path"
  chmod "$mode" "$path"
}
%{ for f in installed ~}
put '${f.path}' '${f.mode}' '${f.owner}' ${action[f.path]} ${join(" ", f.units)}
%{ endfor ~}

# 5. Remove what this deployment no longer installs: files in pruned directories, and unit
#    files it installed last time (their units are stopped first).
%{ for d in prune_dirs ~}
find '${d}' -type f | while IFS= read -r f; do [ -e "$stage$f" ] || { rm -f "$f"; echo "removed $f"; }; done
find '${d}' -mindepth 1 -type d -empty -delete
%{ endfor ~}
state='/var/lib/tofu-deploy/${name}.units'
while IFS= read -r f; do
  if [ -n "$f" ] && [ ! -e "$stage$f" ]; then
    unit=$(basename "$f" .container)
    systemctl stop "$${unit/%.network/-network}" 2>/dev/null || true
    rm -f "$f"
    echo "removed $f"
  fi
done < <(cat "$state" 2>/dev/null)
mkdir -p /var/lib/tofu-deploy
: > "$state"
%{ for f in unit_files ~}
echo '${f}' >> "$state"
%{ endfor ~}

# Debian 13 VMs have no vsock CID, so systemd-ssh-generator fails on every daemon-reload (DT-138).
install -d -m 0755 /etc/systemd/system-generators
ln -sfn /dev/null /etc/systemd/system-generators/systemd-ssh-generator

# 6. Restart, start or reload, in order. Container units with Notify=healthy make systemctl
#    return only when the container is healthy, and fail when it never gets there.
systemctl daemon-reload
%{ for command in post_install ~}
${command}
%{ endfor ~}
for unit in ${join(" ", units)}; do
  if [[ $restart == *" $unit "* ]] || ! systemctl is-active -q "$unit"; then
    echo "restarting $unit"
    systemctl restart "$unit" || { journalctl -u "$unit" -n 25 --no-pager >&2; exit 1; }
  elif [[ $reload == *" $unit "* ]]; then
    echo "reloading $unit"
    systemctl reload-or-restart "$unit" # reload when the unit has ExecReload, else restart
  fi
done

# 7. Checks from outside the containers.
%{ for command in verify ~}
${command}
%{ endfor ~}
echo "deployed ${name} on ${host}: ${join(" ", units)}"
