#!/usr/bin/env python3
"""Build and install selected providers, or all providers when no names are given."""
import argparse
import json
from pathlib import Path
import shutil
import subprocess
import sys

repo = Path(__file__).resolve().parents[1]
manifest = json.loads((repo / "tooling/provider-manifest.json").read_text())
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("providers", nargs="*", metavar="PROVIDER", help="proxmox, vyoscmd, routeros; default: all")
args = parser.parse_args()
unknown = set(args.providers) - manifest.keys()
if unknown:
    parser.error(f"Unknown providers: {', '.join(sorted(unknown))}")
go = shutil.which("go")
if not go:
    # Go is only needed for the provider builds, so the everyday shell (shell.nix) has none:
    # re-run this script inside tooling/build-shell.nix, which brings Go 1.26.
    import os, shlex, sys
    nix_shell = shutil.which("nix-shell")
    if os.environ.get("LYLAT_BUILD_SHELL") or not nix_shell:
        parser.error("Go >= 1.26.0 is required (install Go, or Nix to use tooling/build-shell.nix)")
    os.environ["LYLAT_BUILD_SHELL"] = "1"
    command = shlex.join([str(Path(__file__).resolve()), *sys.argv[1:]])
    os.execv(nix_shell, [nix_shell, str(repo / "tooling/build-shell.nix"), "--run", command])
try:
    # Match the builder's GOOS/GOARCH rather than assuming the host architecture.
    target = "_".join(subprocess.check_output([go, "env", "GOOS", "GOARCH"], text=True).split())
    subprocess.run([sys.executable, str(repo / "tooling/build-providers"), *args.providers], check=True)
    subprocess.run([sys.executable, str(repo / "tooling/install-providers"), "--platform", target, *args.providers], check=True)
except subprocess.CalledProcessError as error:
    sys.exit(error.returncode)
