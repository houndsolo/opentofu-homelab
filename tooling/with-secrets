#!/usr/bin/env python3
"""Load one shared tfvars file as TF_VAR_* settings, then run a command."""
import argparse
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile


def load_values(path, tofu):
    # Parse names only. Let OpenTofu interpret HCL values/escaping/types itself.
    import hcl2
    with path.open() as source:
        names = list(hcl2.load(source))
    names = [json.loads(name) if name.startswith('"') else name for name in names]
    if not all(re.fullmatch(r"[A-Za-z_][A-Za-z0-9_-]*", name) for name in names):
        raise ValueError("Invalid variable name")
    if not names:
        return {}
    with tempfile.TemporaryDirectory(prefix="tofu-secrets-") as temporary:
        directory = Path(temporary)
        declarations = '\n'.join(
            'variable "' + name + '" {\n  sensitive = true\n}\n' for name in names
        )
        (directory / "variables.tf").write_text(declarations)
        # Ignore unrelated provider development overrides and logging for decoding.
        (directory / "empty.tfrc").write_text("")
        environment = dict(os.environ)
        for name in list(environment):
            if name.startswith("TF_CLI_ARGS") or name.startswith("TF_LOG"):
                environment.pop(name)
        environment["TF_CLI_CONFIG_FILE"] = str(directory / "empty.tfrc")
        expression = 'nonsensitive(jsonencode({' + ','.join(
            json.dumps(name) + '=var.' + name for name in names
        ) + '}))\n'
        result = subprocess.run(
            [tofu, "-chdir=" + str(directory), "console", "-no-color", "-var-file=" + str(path)],
            input=expression, text=True, capture_output=True, env=environment,
        )
        if result.returncode:
            # Parser/console diagnostics can contain secret values: never echo them.
            raise ValueError("Cannot decode secrets")
        return json.loads(json.loads(result.stdout))


def main():
    repo = Path(__file__).resolve().parents[1]
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--file", type=Path, default=repo / "inventory/auto.tfvars/passwords.secret.auto.tfvars")
    parser.add_argument("--tofu", default=shutil.which("tofu") or shutil.which("terraform"))
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not command:
        parser.error("Provide a command, e.g. tofu -chdir=roots/services-config plan")
    if not args.tofu:
        parser.error("OpenTofu must be installed; run inside nix-shell")
    path = args.file.resolve()
    # Auto-loaded copies would still emit the warnings this wrapper avoids.
    root = Path.cwd()
    for index, arg in enumerate(command):
        if arg.startswith("-chdir="):
            root = Path(arg.split("=", 1)[1]).resolve()
        elif arg == "-chdir" and index + 1 < len(command):
            root = Path(command[index + 1]).resolve()
    for candidate in root.glob("*.auto.tfvars*"):
        if candidate.resolve() == path:
            parser.error("Remove the root's shared-secrets symlink first (unlink " + str(candidate) + "); keep its central target")
    try:
        values = load_values(path, args.tofu)
    except ImportError:
        parser.error("python-hcl2 is required; run inside nix-shell")
    except Exception:
        parser.error("Could not decode the shared tfvars file. Check its path and syntax; values were not printed")
    environment = dict(os.environ)
    for name, value in values.items():
        key = "TF_VAR_" + name
        if value is None:
            environment.pop(key, None)  # Let optional inputs use their defaults.
        else:
            environment[key] = value if isinstance(value, str) else json.dumps(value)
    try:
        return subprocess.run(command, env=environment).returncode
    except FileNotFoundError:
        parser.error("Command not found")


if __name__ == "__main__":
    sys.exit(main())
