variable "proxmox_settings" {
  description = <<-EOT
    Proxmox VE host-level settings managed by roots/proxmox-settings:
    - datacenter: datacenter options (datacenter.cfg, proxmox_cluster_options), keyed "cluster" (the
      lylat cluster, through var.nodes.cluster_api_node) or the standalone host's name (its own
      datacenter, through the greatfox provider alias). An attribute left null is not managed.
    - dns / time_zone: every Proxmox host (cluster nodes and the standalone host); Proxmox keeps
      DNS and the time zone per node, there is no cluster-wide setting.
    - nodes: per-node overrides of dns / time_zone.
    Not manageable by the provider (left as they are): tag-style, allowed-tags, u2f/webauthn.
    tag-style (ordering=config + color-map) is set by hand; see proxmox-settings.auto.tfvars.
  EOT
  type = object({
    datacenter = optional(map(object({
      keyboard                            = optional(string) # vnc keyboard layout, e.g. "en-us"
      language                            = optional(string) # web UI language, e.g. "en"
      console                             = optional(string) # applet | vv | html5 | xtermjs
      description                         = optional(string) # datacenter notes
      email_from                          = optional(string)
      http_proxy                          = optional(string)
      mac_prefix                          = optional(string) # prefix of autogenerated MACs, e.g. "BC:24:11"
      max_workers                         = optional(number) # parallel workers per node (stopall, ha-manager)
      next_id                             = optional(object({ lower = number, upper = number }))
      bandwidth_limit_clone               = optional(number) # KiB/s
      bandwidth_limit_default             = optional(number)
      bandwidth_limit_migration           = optional(number)
      bandwidth_limit_move                = optional(number)
      bandwidth_limit_restore             = optional(number)
      migration_type                      = optional(string) # secure | insecure
      migration_cidr                      = optional(string) # network used for migrations
      ha_shutdown_policy                  = optional(string) # freeze | failover | migrate | conditional
      crs_ha                              = optional(string) # static | basic | dynamic
      crs_ha_rebalance_on_start           = optional(bool)
      crs_ha_auto_rebalance               = optional(bool)
      crs_ha_auto_rebalance_method        = optional(string) # bruteforce | topsis
      crs_ha_auto_rebalance_threshold     = optional(number) # % imbalance that triggers rebalancing
      crs_ha_auto_rebalance_margin        = optional(number) # % improvement a migration must bring
      crs_ha_auto_rebalance_hold_duration = optional(number) # HA rounds over the threshold first
      notify = optional(object({
        ha_fencing_mode        = optional(string) # always | never
        ha_fencing_target      = optional(string)
        package_updates        = optional(string) # auto | always | never
        package_updates_target = optional(string)
        replication            = optional(string) # always | never
        replication_target     = optional(string)
      }))
    })), {})
    dns = object({
      domain  = string       # search domain
      servers = list(string) # up to 3, in order
    })
    time_zone = string
    nodes = optional(map(object({
      dns = optional(object({
        domain  = string
        servers = list(string)
      }))
      time_zone = optional(string)
    })), {})
  })

  validation {
    condition = alltrue([
      for k, o in var.proxmox_settings.datacenter : (
        (o.migration_type == null || contains(["secure", "insecure"], o.migration_type)) &&
        (o.ha_shutdown_policy == null || contains(["freeze", "failover", "migrate", "conditional"], o.ha_shutdown_policy)) &&
        (o.crs_ha == null || contains(["static", "basic", "dynamic"], o.crs_ha)) &&
        (o.crs_ha_auto_rebalance_method == null || contains(["bruteforce", "topsis"], o.crs_ha_auto_rebalance_method)) &&
        (o.console == null || contains(["applet", "vv", "html5", "xtermjs"], o.console)) &&
        (o.migration_cidr == null || can(cidrhost(o.migration_cidr, 0)))
      )
    ])
    error_message = "proxmox_settings.datacenter: migration_type secure|insecure, ha_shutdown_policy freeze|failover|migrate|conditional, crs_ha static|basic|dynamic, crs_ha_auto_rebalance_method bruteforce|topsis, console applet|vv|html5|xtermjs, migration_cidr a CIDR."
  }
  validation {
    condition = alltrue(concat(
      [length(var.proxmox_settings.dns.servers) >= 1 && length(var.proxmox_settings.dns.servers) <= 3],
      [for n in values(var.proxmox_settings.nodes) : n.dns == null || try(length(n.dns.servers) >= 1 && length(n.dns.servers) <= 3, false)],
    ))
    error_message = "proxmox_settings dns.servers: 1 to 3 servers (Proxmox keeps dns1..dns3)."
  }
}
