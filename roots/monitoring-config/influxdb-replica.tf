# The replica backend's InfluxDB (mon02): the same buckets as mon01. The C9800s send to the
# monitoring VIP, whose Telegraf writes into both (module telemetry.tf) with the wlc bucket's
# write-only token. The pve buckets only keep pvestatd's history until 2026-11-13 (backfill
# source, pve-metrics.tf): pvestatd no longer writes to InfluxDB, so they have no token.
#
# Both InfluxDBs were set up with the same operator token (random_password.influxdb_token),
# which the replica provider and Grafana use. Write tokens differ per InfluxDB (they're
# generated by the server).
#
# Everything here waits for influxdb_replica_ready = true: the provider has to reach a
# running InfluxDB to plan, so deploy mon02 first (see the README runbook).

# The provider pings its URL when it's configured, even with nothing to manage, so until
# influxdb_replica_ready it points at the primary (and manages nothing there).
provider "influxdb" {
  alias = "replica"
  url   = "http://${coalesce(try(local.monitoring_address[local.replica_influxdb ? local.replica_name : local.backend_name], null), "0.0.0.0")}:8086"
  token = random_password.influxdb_token.result
}

locals {
  replica_buckets = merge(
    { for key, name in local.pve_metric_buckets : "pve-${key}" => { name = name, description = "Proxmox metric server: ${key}" } },
    var.wlc_telemetry == null ? {} : { wlc = { name = var.wlc_telemetry.bucket, description = "Telegraf on ${coalesce(local.replica_name, "the replica")}: Cisco C9800 model-driven telemetry" } },
  )
}

data "influxdb_organization" "replica" {
  count    = local.replica_influxdb ? 1 : 0
  provider = influxdb.replica

  name = var.settings.influxdb_org
}

resource "influxdb_bucket" "replica" {
  for_each = local.replica_influxdb ? local.replica_buckets : {}
  provider = influxdb.replica

  name             = each.value.name
  org_id           = data.influxdb_organization.replica[0].id
  description      = each.value.description
  retention_period = var.pve_metrics.retention_days * 86400
}

resource "influxdb_authorization" "replica" {
  for_each = local.replica_influxdb ? { for key, b in local.replica_buckets : key => b if !startswith(key, "pve-") } : {}
  provider = influxdb.replica

  org_id      = data.influxdb_organization.replica[0].id
  description = "${each.value.description} -> ${each.value.name}, write only"
  permissions = [{
    action = "write"
    resource = {
      type   = "buckets"
      id     = influxdb_bucket.replica[each.key].id
      org_id = data.influxdb_organization.replica[0].id
    }
  }]
}
