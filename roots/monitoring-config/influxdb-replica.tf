# The replica backend's InfluxDB (mon02): the same buckets as mon01, each with its own
# write-only token, and a second Proxmox metric server per cluster/standalone host, so
# pvestatd pushes to both InfluxDBs. The C9800s send to both Telegrafs (two named
# receivers per subscription, configured by hand), and VyOS writes through the relay
# (vyos_influx_relay_port), which copies into both.
#
# Both InfluxDBs were set up with the same operator token (random_password.influxdb_token),
# which the replica provider and Grafana use. Write tokens differ per InfluxDB (they're
# generated by the server), which is why VyOS (one URL, one token) goes through the relay.
#
# Everything here waits for influxdb_replica_ready = true: the provider has to reach a
# running InfluxDB to plan, so deploy mon02 first (see the README runbook).

# The provider pings its URL when it's configured, even with nothing to manage, so until
# influxdb_replica_ready it points at the primary (and manages nothing there).
provider "influxdb" {
  alias = "replica"
  url   = "http://${coalesce(try(local.monitoring_address[local.replica_influxdb ? local.replica_name : local.backend_name], null), "0.0.0.0")}:8086"
  token = random_password.influxdb_token.result
}

locals {
  replica_buckets = merge(
    { for key, name in local.pve_metric_buckets : "pve-${key}" => { name = name, description = "Proxmox metric server: ${key}" } },
    { vyos = { name = var.vyos_telegraf_bucket, description = "Telegraf on VyOS routers (through the InfluxDB relay)" } },
    var.wlc_telemetry == null ? {} : { wlc = { name = var.wlc_telemetry.bucket, description = "Telegraf on ${coalesce(local.replica_name, "the replica")}: Cisco C9800 model-driven telemetry" } },
  )
}

data "influxdb_organization" "replica" {
  count    = local.replica_influxdb ? 1 : 0
  provider = influxdb.replica

  name = var.settings.influxdb_org
}

resource "influxdb_bucket" "replica" {
  for_each = local.replica_influxdb ? local.replica_buckets : {}
  provider = influxdb.replica

  name             = each.value.name
  org_id           = data.influxdb_organization.replica[0].id
  description      = each.value.description
  retention_period = var.pve_metrics.retention_days * 86400
}

resource "influxdb_authorization" "replica" {
  for_each = local.replica_influxdb ? local.replica_buckets : {}
  provider = influxdb.replica

  org_id      = data.influxdb_organization.replica[0].id
  description = "${each.value.description} -> ${each.value.name}, write only"
  permissions = [{
    action = "write"
    resource = {
      type   = "buckets"
      id     = influxdb_bucket.replica[each.key].id
      org_id = data.influxdb_organization.replica[0].id
    }
  }]
}

# A second metric server entry per cluster/host, next to "influxdb" (mon01, pve-metrics.tf).
resource "proxmox_metrics_server" "cluster_replica" {
  count = local.replica_influxdb ? 1 : 0

  name                = "influxdb-${local.replica_name}"
  server              = local.monitoring_address[local.replica_name]
  port                = local.pve_metric_server.port
  type                = local.pve_metric_server.type
  influx_db_proto     = local.pve_metric_server.influx_db_proto
  influx_organization = local.pve_metric_server.influx_organization
  influx_bucket       = influxdb_bucket.replica["pve-cluster"].name
  influx_token        = influxdb_authorization.replica["pve-cluster"].token
  disable             = local.pve_metric_server.disable
}

resource "proxmox_metrics_server" "standalone_replica" {
  for_each = local.replica_influxdb ? toset(local.standalone_pve) : toset([])
  provider = proxmox.greatfox

  name                = "influxdb-${local.replica_name}"
  server              = local.monitoring_address[local.replica_name]
  port                = local.pve_metric_server.port
  type                = local.pve_metric_server.type
  influx_db_proto     = local.pve_metric_server.influx_db_proto
  influx_organization = local.pve_metric_server.influx_organization
  influx_bucket       = influxdb_bucket.replica["pve-${each.key}"].name
  influx_token        = influxdb_authorization.replica["pve-${each.key}"].token
  disable             = local.pve_metric_server.disable
}
