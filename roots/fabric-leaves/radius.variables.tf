# Written by roots/radius (inventory/auto.tfvars.secret/radius-clients.secret.auto.tfvars, git-ignored,
# linked here as radius-clients.secret.auto.tfvars). Apply roots/radius first: it generates the secrets.
variable "radius_servers" {
  description = "FreeRADIUS servers (rad01/rad02 mgmt addresses) the leaves log in against."
  type        = list(string)
  default     = []
}

variable "radius_client_secrets" {
  description = "RADIUS client name (leaf-<id>) => shared secret, generated by roots/radius."
  type        = map(string)
  sensitive   = true
  default     = {}
}
