[Unit]
Description=BIND9 DNS resolver and lylat.space authority
Wants=network-online.target
After=network-online.target

[Container]
Image=${image}
ContainerName=bind9
Network=host
Volume=/etc/bind9-container:/etc/bind:ro
Volume=/var/lib/bind9-container:/var/lib/bind:rw
# The image entrypoint already runs /usr/sbin/named -u bind. -f (foreground) and not -g: -g forces
# its own stderr logging and ignores named.conf's logging statement (no severity in the lines).
Exec=-f -c /etc/bind/named.conf

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
