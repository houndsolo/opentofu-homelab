# Managed by OpenTofu (services-config, arr.tf). Local edits are overwritten.
# One pod for the arr stack: the apps reach each other on localhost; every web UI is published on the VM's
# main address (VLAN 2), where the proxy pair forwards https://<app>.lylat.space.
[Unit]
Description=arr stack pod
RequiresMountsFor=/data

[Pod]
PodName=arr
%{ for port in ports ~}
PublishPort=${listen}:${port}:${port}
%{ endfor ~}

[Install]
WantedBy=multi-user.target
