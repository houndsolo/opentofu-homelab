#!/bin/bash
# dark-triage deploy (services-config ticketing.tf): build the pinned commit, install the Quadlet
# unit and (HA) keepalived. Fails, without touching the other nodes, if the app isn't healthy.
set -euo pipefail
umask 077
command -v podman >/dev/null
stage=$(mktemp -d /tmp/tofu-triage.XXXXXX)
trap 'rm -rf "$stage"' EXIT

if ! podman image exists '${image}'; then
  mkdir "$stage/src"
  if command -v curl >/dev/null; then curl -fsSL '${tarball}' -o "$stage/src.tar.gz"; else wget -qO "$stage/src.tar.gz" '${tarball}'; fi
  tar -xzf "$stage/src.tar.gz" -C "$stage/src" --strip-components=1
  chmod -R a+rX "$stage/src"
  podman build --pull=newer -t '${image}' "$stage/src"
fi

%{ if ha ~}
# The VIP is published on both nodes; only the MASTER holds it.
printf 'net.ipv4.ip_nonlocal_bind = 1\n' > /etc/sysctl.d/90-dark-triage.conf
chmod 0644 /etc/sysctl.d/90-dark-triage.conf
sysctl -q -p /etc/sysctl.d/90-dark-triage.conf
%{ endif ~}

install -d -m 0755 /etc/dark-triage /etc/containers/systemd
install -d -m 0750 -o 1000 -g 1000 /var/lib/dark-triage
printf '%s' '${env_b64}' | base64 -d > "$stage/env"
printf '%s' '${unit_b64}' | base64 -d > "$stage/dark-triage.container"
# Restart the app only when its unit, env or image changed (or it isn't running): a deploy that
# only changes keepalived must not interrupt the node holding the VIP.
changed=0
cmp -s "$stage/env" /etc/dark-triage/env || changed=1
cmp -s "$stage/dark-triage.container" /etc/containers/systemd/dark-triage.container || changed=1
install -m 0600 -o root -g root "$stage/env" /etc/dark-triage/env
install -m 0644 "$stage/dark-triage.container" /etc/containers/systemd/dark-triage.container
if [ $changed -eq 1 ] || ! systemctl is-active --quiet dark-triage.service; then
  systemctl daemon-reload
  systemctl restart dark-triage.service
  echo "dark-triage restarted"
else
  echo "dark-triage unchanged, not restarted"
fi

healthy=0
for i in $(seq 1 45); do
  code=$(curl -s -o /dev/null -w '%%{http_code}' --max-time 3 'http://${listen}:3000/api/health' || true)
  if [ "$code" = 200 ]; then echo "dark-triage is healthy on ${listen} (/api/health 200)"; healthy=1; break; fi
  sleep 2
done
if [ $healthy -ne 1 ]; then
  echo "dark-triage is not healthy on http://${listen}:3000/api/health (last HTTP $code)" >&2
  journalctl -u dark-triage.service -n 30 --no-pager >&2
  exit 1
fi

%{ if ha ~}
printf '%s' '${keepalived_b64}' | base64 -d > "$stage/keepalived.conf"
printf '%s' '${check_b64}' | base64 -d > "$stage/chk_triage.sh"
if ! command -v keepalived >/dev/null; then
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -q
  apt-get install -y -q --no-install-recommends keepalived
fi
install -d -m 0755 /etc/keepalived
# enable_script_security: the check must be root-owned and not writable by others.
install -m 0755 -o root -g root "$stage/chk_triage.sh" /etc/keepalived/chk_triage.sh
keepalived -t -f "$stage/keepalived.conf"
install -m 0600 -o root -g root "$stage/keepalived.conf" /etc/keepalived/keepalived.conf
systemctl enable --quiet keepalived.service
# Reload keeps the VRRP state (no VIP move); start only when not running yet.
if systemctl is-active --quiet keepalived.service; then systemctl reload keepalived.service; else systemctl start keepalived.service; fi
systemctl is-active --quiet keepalived.service
echo "keepalived running"
%{ endif ~}
