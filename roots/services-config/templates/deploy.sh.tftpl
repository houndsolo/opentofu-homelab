#!/bin/bash
set -euo pipefail
umask 077
command -v podman >/dev/null
stage=$(mktemp -d /tmp/tofu-bind9.XXXXXX)
trap 'rm -rf "$stage"' EXIT
image=$(printf '%s' '${image_b64}' | base64 -d)
printf '%s' '${config_b64}' | base64 -d > "$stage/named.conf"
printf '%s' '${zone_b64}' | base64 -d > "$stage/seed.zone"
printf '%s' '${reverse_b64}' | base64 -d > "$stage/seed-reverse.zone"
printf '%s' '${quadlet_b64}' | base64 -d > "$stage/bind9.container"
printf '%s' '${key_b64}' | base64 -d > "$stage/tsig.key"

podman pull "$image"
# Validation runs as root with networking disabled; key contents stay private.
podman run --rm --network=none --entrypoint named-checkconf \
  -v "$stage:/etc/bind:ro" "$image" /etc/bind/named.conf
podman run --rm --network=none --entrypoint named-checkzone \
  -v "$stage:/etc/bind:ro" "$image" lylat.space /etc/bind/seed.zone
podman run --rm --network=none --entrypoint named-checkzone \
  -v "$stage:/etc/bind:ro" "$image" 10.in-addr.arpa /etc/bind/seed-reverse.zone

bind_uid=$(podman run --rm --network=none --entrypoint id "$image" -u bind)
bind_gid=$(podman run --rm --network=none --entrypoint id "$image" -g bind)
install -d -m 0755 /etc/bind9-container /etc/containers/systemd
install -d -m 0750 -o "$bind_uid" -g "$bind_gid" \
  /var/lib/bind9-container /var/lib/bind9-container/primary /var/lib/bind9-container/secondary
%{ if primary ~}
# Seed only once. Never replace a dynamic zone or its journal on redeployment.
if [ ! -f /var/lib/bind9-container/primary/lylat.space.zone ]; then
  install -m 0640 -o "$bind_uid" -g "$bind_gid" \
    "$stage/seed.zone" /var/lib/bind9-container/primary/lylat.space.zone
fi
if [ ! -f /var/lib/bind9-container/primary/10.in-addr.arpa.zone ]; then
  install -m 0640 -o "$bind_uid" -g "$bind_gid" \
    "$stage/seed-reverse.zone" /var/lib/bind9-container/primary/10.in-addr.arpa.zone
fi
%{ endif ~}
# A change to named.conf or the key alone is a reload (SIGHUP = rndc reload; there is no rndc
# channel), so the resolver keeps its cache and never drops queries. A new unit or image, or a stopped
# service, is a restart. Dynamic zones and their journals survive both.
same() { [ -f "$2" ] && cmp -s "$1" "$2"; }
same "$stage/named.conf" /etc/bind9-container/named.conf && same "$stage/tsig.key" /etc/bind9-container/tsig.key && config_changed=0 || config_changed=1
same "$stage/bind9.container" /etc/containers/systemd/bind9.container && unit_changed=0 || unit_changed=1
running_image=$(podman inspect --format '{{.Image}}' bind9 2>/dev/null || true)
[ "$running_image" = "$(podman image inspect --format '{{.Id}}' "$image")" ] && image_changed=0 || image_changed=1

install -m 0644 "$stage/named.conf" /etc/bind9-container/named.conf
install -m 0640 -o root -g "$bind_gid" "$stage/tsig.key" /etc/bind9-container/tsig.key
install -m 0644 "$stage/bind9.container" /etc/containers/systemd/bind9.container
systemctl daemon-reload
if [ $unit_changed -eq 1 ] || [ $image_changed -eq 1 ] || ! systemctl is-active --quiet bind9.service; then
  echo "bind9: restart (unit changed=$unit_changed, image changed=$image_changed)"
  systemctl restart bind9.service
elif [ $config_changed -eq 1 ]; then
  echo "bind9: reload (named.conf or key changed)"
  since=$(date +%s)
  podman kill --signal HUP bind9 >/dev/null
  result=
  for i in $(seq 1 30); do
    result=$(podman logs --since "$since" bind9 2>&1 | grep -oE 'reloading configuration (succeeded|failed.*)' | tail -n 1 || true)
    [ -n "$result" ] && break
    sleep 1
  done
  echo "bind9: $${result:-no reload result logged in 30 s}"
  # On a failed reload named keeps running with the old config: fail the deploy so it gets fixed.
  [ "$result" = "reloading configuration succeeded" ]
else
  echo "bind9: unchanged"
fi
systemctl is-active --quiet bind9.service
