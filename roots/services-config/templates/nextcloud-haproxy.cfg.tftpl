# Managed by OpenTofu (services-config, nextcloud.tf). Local edits are overwritten.
# HAProxy in the Nextcloud pod: 127.0.0.1:6379 -> the Valkey node that is currently the primary, for PHP
# sessions only (phpredis has no Sentinel mode; caching and locking ask the Sentinels themselves).
# Sentinel still decides who the primary is; HAProxy follows its result on the nodes themselves:
#  1. Sentinel promotes a replica (REPLICAOF NO ONE): it now answers role:master.
#  2. Sentinel repoints the other replica to it: it now has connected_slaves >= 1.
#  3. A node is UP here only when both are true. A cut-off old primary still says role:master until
#     Sentinel demotes it, but its replicas already moved, so it fails step 2 and never gets writes.
# Cost: both replicas down at once = the primary fails the check too = no sessions until one is back.
# VALKEY_PASSWORD comes from /etc/nextcloud/haproxy.env (0600), never from this file.
global
    log stdout format raw local0 notice

defaults
    mode    tcp
    log     global
    timeout connect 2s
    # phpredis keeps a connection per request; long timeouts only matter for slow session locks.
    timeout client  1h
    timeout server  1h

frontend valkey_sessions
    bind 127.0.0.1:6379
    default_backend valkey_primary

backend valkey_primary
    # "first": everything to the first server that is UP. Normally exactly one passes; if two ever did,
    # every node would still pick the same one (lowest id).
    balance first
    option tcp-check
    tcp-check connect
    tcp-check send "AUTH $${VALKEY_PASSWORD}\r\n"
    tcp-check expect string +OK
    tcp-check send "PING\r\n"
    tcp-check expect string +PONG
    tcp-check send "INFO replication\r\n"
    tcp-check expect string role:master
    tcp-check expect rstring connected_slaves:[1-9]
    tcp-check send "QUIT\r\n"
    tcp-check expect string +OK
    # Every second; 2 failures = DOWN, 2 passes = UP. A node marked DOWN gets its open connections cut, so
    # PHP reconnects through the new primary at once.
    default-server inter 1s fall 2 rise 2 on-marked-down shutdown-sessions
%{ for name, address in servers ~}
    server ${name} ${address}:6379 check
%{ endfor ~}
