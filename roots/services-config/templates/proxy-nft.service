[Unit]
Description=nftables rules for the reverse proxy (80/443)
# No default dependencies (as nftables.service and monitoring's *-guard units): those add
# After=basic.target, and with Before=network-pre.target that is an ordering cycle at boot
# (basic -> proxy-nft -> network-pre -> networkd -> wait-online -> cloud-init-network -> sysinit ->
# basic); systemd then deletes cloud-init-network's job and the boot hangs in "starting"
# (proxy02, 2026-11-13).
DefaultDependencies=no
After=local-fs.target
Wants=network-pre.target
Before=network-pre.target shutdown.target nginx.service
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/nftables-proxy.nft
ExecStop=/usr/sbin/nft delete table inet proxy

[Install]
WantedBy=multi-user.target
