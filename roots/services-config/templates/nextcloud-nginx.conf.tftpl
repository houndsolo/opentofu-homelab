# Managed by OpenTofu (services-config, nextcloud.tf). Local edits are overwritten.
# nginx in the Nextcloud pod, adapted from Nextcloud's docker example (.examples/.../fpm/web/nginx.conf):
# static files from /var/www/html (read-only copy of the node's code), PHP to php-fpm on 127.0.0.1:9000.
# TLS ends at the reverse proxy pair; this listens on plain HTTP, published on the node's lylat-app address.
user  nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid       /run/nginx.pid;

events {
  worker_connections 1024;
}

http {
  include      /etc/nginx/mime.types;
  default_type application/octet-stream;
  types {
    text/javascript mjs;
  }
  # client = the proxy; xff = the real client (Nextcloud itself trusts X-Forwarded-For from the proxies).
  log_format nextcloud 'status=$status method=$request_method uri="$uri" rt=$request_time client=$remote_addr '
                       'xff="$http_x_forwarded_for" ua="$http_user_agent"';
  access_log /var/log/nginx/access.log nextcloud;
  sendfile        on;
  server_tokens   off;
  keepalive_timeout 65;

  # `immutable` only for assets with a cache-busting ?v= argument.
  map $arg_v $asset_immutable {
    ""      "";
    default ", immutable";
  }

  upstream php-handler {
    server 127.0.0.1:9000;
  }

  server {
    listen 80;

    # Redirects stay relative (Location: /remote.php/dav/), so clients keep https and the public name
    # instead of this node's http://<address>.
    absolute_redirect off;

    # HSTS: Nextcloud's admin overview warns without it. No preload.
    add_header Strict-Transport-Security "max-age=15768000; includeSubDomains" always;

    # Uploads: the browser and the clients chunk big files; single PUTs (WebDAV) up to the PHP limit.
    client_max_body_size ${upload_limit};
    client_body_timeout  300s;
    client_body_buffer_size 512k;
    fastcgi_buffers 64 4K;
    fastcgi_read_timeout 3600s;

    gzip on;
    gzip_vary on;
    gzip_comp_level 4;
    gzip_min_length 256;
    gzip_proxied expired no-cache no-store private no_last_modified no_etag auth;
    gzip_types application/atom+xml text/javascript application/javascript application/json application/ld+json application/manifest+json application/rss+xml application/vnd.geo+json application/vnd.ms-fontobject application/wasm application/x-font-ttf application/x-web-app-manifest+json application/xhtml+xml application/xml font/opentype image/bmp image/svg+xml image/x-icon text/cache-manifest text/css text/plain text/vcard text/vnd.rim.location.xloc text/vtt text/x-component text/x-cross-domain-policy;

    # Response headers from Nextcloud's .htaccess.
    add_header Referrer-Policy                   "no-referrer"       always;
    add_header X-Content-Type-Options            "nosniff"           always;
    add_header X-Frame-Options                   "SAMEORIGIN"        always;
    add_header X-Permitted-Cross-Domain-Policies "none"              always;
    add_header X-Robots-Tag                      "noindex, nofollow" always;
    fastcgi_hide_header X-Powered-By;

    root /var/www/html;
    index index.php index.html /index.php$request_uri;

    # Microsoft DAV clients.
    location = / {
      if ( $http_user_agent ~ ^DavClnt ) {
        return 302 /remote.php/webdav/$is_args$args;
      }
    }

    location = /robots.txt {
      allow all;
      log_not_found off;
      access_log off;
    }

    # CalDAV/CardDAV discovery and Nextcloud's other /.well-known URIs.
    location ^~ /.well-known {
      location = /.well-known/carddav { return 301 /remote.php/dav/; }
      location = /.well-known/caldav  { return 301 /remote.php/dav/; }
      location /.well-known/acme-challenge { try_files $uri $uri/ =404; }
      location /.well-known/pki-validation { try_files $uri $uri/ =404; }
      return 301 /index.php$request_uri;
    }

    # Paths .htaccess hides.
    location ~ ^/(?:build|tests|config|lib|3rdparty|templates|data)(?:$|/)  { return 404; }
    location ~ ^/(?:\.|autotest|occ|issue|indie|db_|console)                { return 404; }

    # PHP; must come before the static-file blocks.
    location ~ \.php(?:$|/) {
      rewrite ^/(?!index|remote|public|cron|core\/ajax\/update|status|ocs\/v[12]|updater\/.+|ocs-provider\/.+|.+\/richdocumentscode(_arm64)?\/proxy) /index.php$request_uri;

      fastcgi_split_path_info ^(.+?\.php)(/.*)$;
      set $path_info $fastcgi_path_info;
      try_files $fastcgi_script_name =404;

      include /etc/nginx/fastcgi_params;
      fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
      fastcgi_param PATH_INFO $path_info;
      fastcgi_param modHeadersAvailable true;     # the headers above are already sent
      fastcgi_param front_controller_active true; # pretty URLs
      fastcgi_pass php-handler;

      fastcgi_intercept_errors on;
      fastcgi_request_buffering on;               # php-fpm needs a Content-Length (no chunked bodies)
      fastcgi_max_temp_file_size 0;
    }

    location ~ \.(?:css|js|mjs|svg|gif|ico|jpg|png|webp|wasm|tflite|map|ogg|flac|mp4|webm)$ {
      try_files $uri /index.php$request_uri;
      add_header Cache-Control                     "public, max-age=15778463$asset_immutable";
      add_header Strict-Transport-Security         "max-age=15768000; includeSubDomains" always;
      add_header Referrer-Policy                   "no-referrer"       always;
      add_header X-Content-Type-Options            "nosniff"           always;
      add_header X-Frame-Options                   "SAMEORIGIN"        always;
      add_header X-Permitted-Cross-Domain-Policies "none"              always;
      add_header X-Robots-Tag                      "noindex, nofollow" always;
      access_log off;
    }

    location ~ \.(otf|woff2?)$ {
      try_files $uri /index.php$request_uri;
      expires 7d;
      access_log off;
    }

    location /remote {
      return 301 /remote.php$request_uri;
    }

    location / {
      try_files $uri $uri/ /index.php$request_uri;
    }
  }
}
