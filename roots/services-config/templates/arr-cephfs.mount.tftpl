# Managed by OpenTofu (services-config, arr.tf). CephFS /media at /data: downloads (/data/torrents, written by
# qBittorrent on CT 877) and the library (/data/library) on ONE mount, so Sonarr/Radarr imports are hardlinks.
[Unit]
Description=CephFS /media (arr stack: torrents and library)
Wants=network-online.target
After=network-online.target

[Mount]
What=${what}
Where=/data
Type=ceph
Options=${options}
TimeoutSec=60

[Install]
WantedBy=remote-fs.target
