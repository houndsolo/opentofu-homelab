#!/bin/bash
# FreeRADIUS deploy (services-config radius.tf): host config, the Quadlet container, the database schema
# (canary only, empty tables). No users, client secrets or certs: those are managed outside this repo.
# Fails, without touching the other server, unless
#   1. FreeRADIUS answers a Status-Server request on 127.0.0.1:1812 (the image's localhost client), and
#   2. an Access-Request for a random, non-existent user is rejected AND logged in radpostauth
#      (proves the RADIUS -> sql -> Postgres path, writes included).
set -euo pipefail
umask 077
command -v podman >/dev/null
stage=$(mktemp -d /tmp/tofu-radius.XXXXXX)
trap 'rm -rf "$stage"' EXIT
export DEBIAN_FRONTEND=noninteractive
host=$(hostname -s)

podman image exists '${image}' || podman pull -q '${image}' >/dev/null
command -v psql >/dev/null || { apt-get update -q; apt-get install -y -q --no-install-recommends postgresql-client; }

# --- Host config: /etc/radius is root-only; the files inside are read by the container ---
install -d -m 0700 /etc/radius
install -d -m 0755 /etc/containers/systemd
printf '%s' '${sql_b64}' | base64 -d > "$stage/sql"
printf '%s' '${env_b64}' | base64 -d > "$stage/radius.env"
printf '%s' '${unit_b64}' | base64 -d > "$stage/radius.container"
changed=0
cmp -s "$stage/sql" /etc/radius/sql || changed=1
cmp -s "$stage/radius.env" /etc/radius/radius.env || changed=1
cmp -s "$stage/radius.container" /etc/containers/systemd/radius.container || changed=1
# 0644 inside the 0700 dir: freeradius drops to its own user (freerad) in the container after start.
install -m 0644 -o root -g root "$stage/sql" /etc/radius/sql
install -m 0600 -o root -g root "$stage/radius.env" /etc/radius/radius.env
install -m 0644 -o root -g root "$stage/radius.container" /etc/containers/systemd/radius.container
# Gone from this deploy (managed elsewhere now): an older tofu-written clients.conf.
rm -f /etc/radius/clients.conf

# Check the whole config with the image before (re)starting the service (-C: check and exit).
podman run --rm --network none --env-file /etc/radius/radius.env -v /etc/radius/sql:/etc/freeradius/mods-enabled/sql:ro \
  '${image}' -C -l stdout > "$stage/check.log" 2>&1 || { tail -30 "$stage/check.log" >&2; echo "freeradius config check failed" >&2; exit 1; }
echo "freeradius config ok"

# --- Database (role + database come from monitoring-config) ---
printf '%s' '${pgpass_b64}' | base64 -d > "$stage/pgpass"
chmod 0600 "$stage/pgpass"
export PGPASSFILE="$stage/pgpass" PGSSLMODE=require PGCONNECT_TIMEOUT=5
pg() { psql -h '${db_host}' -p '${db_port}' -U '${db_user}' -d '${db_name}' -v ON_ERROR_STOP=1 -X -q "$@"; }
%{ if canary ~}
# Schema: the image's postgresql/schema.sql, only when the tables don't exist yet (canary only).
if [ "$(pg -Atc "select to_regclass('public.radpostauth') is not null")" != t ]; then
  podman run --rm --entrypoint cat '${image}' /etc/freeradius/mods-config/sql/main/postgresql/schema.sql > "$stage/schema.sql"
  pg -f "$stage/schema.sql"
  echo "radius schema loaded"
fi
%{ endif ~}
[ "$(pg -Atc "select to_regclass('public.radpostauth') is not null")" = t ] || { echo "radius schema missing (the canary loads it)" >&2; exit 1; }

# --- Start or restart (only when something changed or it isn't running) ---
if [ "$changed" = 1 ] || ! systemctl is-active --quiet radius.service; then
  systemctl daemon-reload
  systemctl restart radius.service
  echo "radius restarted"
else
  echo "radius unchanged, not restarted"
fi

# --- Health. testing123 is the image's default localhost-only secret (clients.conf: 127.0.0.1 only). ---
fail() { journalctl -u radius.service -n 40 --no-pager -o cat >&2; echo "radius is not healthy: $1" >&2; exit 1; }
ok=0
for i in $(seq 1 30); do
  if printf 'Message-Authenticator = 0x00\n' | podman exec -i radius radclient -r 1 -t 2 127.0.0.1:1812 status testing123 2>&1 | grep -q 'Received Access-Accept'; then ok=1; break; fi
  sleep 2
done
[ "$ok" = 1 ] || fail "no answer to Status-Server on 127.0.0.1:1812"
echo "radius answers Status-Server on 127.0.0.1:1812"

probe="lylat-probe-$host-$(head -c 6 /dev/urandom | od -An -tx1 | tr -d ' \n')"
since=$(pg -Atc "select now()")
reply=$(podman exec radius radtest -t pap "$probe" "$(head -c 12 /dev/urandom | od -An -tx1 | tr -d ' \n')" 127.0.0.1 0 testing123 2>&1 | grep -oE 'Received Access-(Accept|Reject)' | head -1 || true)
[ "$reply" = "Received Access-Reject" ] || fail "probe user $probe: expected Access-Reject, got '$reply'"
logged=0
for i in $(seq 1 10); do
  n=$(pg -Atc "select count(*) from radpostauth where username = '$probe' and authdate >= '$since'")
  [ "$n" -ge 1 ] && { logged=1; break; }
  sleep 1
done
[ "$logged" = 1 ] || fail "probe $probe was rejected but not logged in radpostauth (no working sql connection)"
pg -c "delete from radpostauth where username = '$probe'"
echo "radius is healthy: probe rejected and logged in Postgres (${db_name} on ${db_host})"
