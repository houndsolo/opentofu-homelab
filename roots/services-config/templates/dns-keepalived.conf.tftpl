# Managed by OpenTofu (services-config). Local edits are overwritten.
# VRRP for the DNS VIP on ${host}: adverts go unicast over the HA L2VNI (${ha_interface}),
# the VIP sits on BIND's service NIC (${interface}).

global_defs {
  router_id ${host}
  script_user nobody nogroup
  enable_script_security
  vrrp_garp_master_refresh 60
}

# No weight: a failing check puts the node in FAULT, which releases the VIP. (With
# nopreempt a lowered priority would never move it.)
vrrp_script chk_bind {
  script "/etc/keepalived/chk_bind.sh"
  interval 5
  timeout 4
  fall 3
  rise 2
  init_fail
}

vrrp_instance dns {
  # Both start BACKUP and nobody preempts: priority only decides the first election,
  # and a recovered node doesn't pull the VIP back (no second interruption, fewer EVPN moves).
  state BACKUP
  nopreempt
  interface ${ha_interface}
  virtual_router_id ${router_id}
  priority ${priority}
  advert_int 1
  unicast_src_ip ${ha_address}
  unicast_peer {
%{ for peer in peers ~}
    ${peer}
%{ endfor ~}
  }
  authentication {
    auth_type PASS
    auth_pass ${auth_pass}
  }
  # use_vmac: each VIP sits on a macvlan with the VRRP virtual MAC 00:00:5e:00:01:<VRID>, so its MAC
  # never changes on failover (with ARP suppression the new MASTER's gratuitous ARP doesn't reach
  # same-VLAN hosts, DT-045); only its EVPN location moves. Adverts stay on the HA L2VNI.
  virtual_ipaddress {
    ${vip} dev ${interface} use_vmac
%{ if zone_vip != null ~}
    ${zone_vip} dev ${zone_interface}
%{ endif ~}
  }
  track_interface {
    ${interface}
%{ if zone_vip != null ~}
    ${zone_interface}
%{ endif ~}
  }
  track_script {
    chk_bind
  }
}
