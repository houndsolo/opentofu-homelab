# Managed by OpenTofu (services-config, gitea.tf). CephFS /gitea: Gitea's repositories, LFS objects,
# attachments, avatars, SSH host keys and custom files, mounted on every Gitea VM (kernel client over the
# Ceph public NIC).
[Unit]
Description=CephFS for Gitea (repositories and data)
Wants=network-online.target
After=network-online.target

[Mount]
What=${what}
Where=/var/lib/gitea
Type=ceph
Options=${options}
TimeoutSec=60

[Install]
WantedBy=remote-fs.target
