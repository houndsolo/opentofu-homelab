# Managed by OpenTofu (services-config, ticketing.tf). Local edits are overwritten.
[Unit]
Description=dark-triage helpdesk
Wants=network-online.target
After=network-online.target

[Container]
Image=${image}
ContainerName=dark-triage
EnvironmentFile=/etc/dark-triage/env
Volume=/var/lib/dark-triage:/app/data
# The node's own VLAN 2 address and the keepalived VIP (bound on both nodes: ip_nonlocal_bind).
%{ for a in addresses ~}
%{ for p in ports ~}
PublishPort=${a}:${p}:3000
%{ endfor ~}
%{ endfor ~}

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
