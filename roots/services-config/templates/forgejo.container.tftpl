# Managed by OpenTofu (services-config, forgejo.tf). Local edits are overwritten.
# Forgejo (official rootless image, uid/gid 1000)%{ if standby } - hot standby: the proxy pair sends traffic here only while the primary is down%{ endif }.
# Web UI/API on :3000 and the built-in SSH server on :2222, both published on the node's lylat-app address; the
# proxy pair forwards https://${domain}/ and :2222. /var/lib/forgejo is CephFS (shared by every node), seen as
# /var/lib/gitea in the container; app.ini is local (/etc/forgejo = /etc/gitea).
[Unit]
Description=Forgejo
Wants=network-online.target
RequiresMountsFor=/var/lib/forgejo
After=network-online.target

[Container]
Image=${image}
ContainerName=forgejo
PublishPort=${listen}:3000:3000
PublishPort=${listen}:2222:2222
Volume=/var/lib/forgejo:/var/lib/gitea
Volume=/etc/forgejo:/etc/gitea
# The rootless image's default config path is under the data dir (custom/conf); ours is local.
Environment=GITEA_APP_INI=/etc/gitea/app.ini
# Health: the HTTP server answers (no database round trip). Notify=healthy: systemctl start/restart returns
# only once it does (after database migrations on the first start of a new version).
HealthCmd=curl -fsS -o /dev/null http://127.0.0.1:3000/api/v1/version
HealthInterval=30s
HealthTimeout=30s
HealthStartPeriod=5m
Notify=healthy

[Service]
Restart=always
# A new version migrates the database before the HTTP server starts.
TimeoutStartSec=1800
# Running git operations (pushes, clones over SSH) get time to finish.
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
