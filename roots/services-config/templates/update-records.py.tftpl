#!/usr/bin/env python3
"""Replace desired RRsets via authenticated RFC 2136; remove previously managed ones."""
import base64
import fcntl
import json
import os
from pathlib import Path
import subprocess
import tempfile
import time

payload = json.loads(base64.b64decode("${payload_b64}"))
manifest = Path("/var/lib/bind9-tofu-records.json")
# Store only owner/type ownership, never the TSIG key. Keep this outside bind's volume.
with open("/run/lock/bind9-tofu-records.lock", "w") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    previous = json.loads(manifest.read_text()) if manifest.exists() else []
    desired = [(r["name"], r["type"]) for r in payload["rrsets"]]
    lines = ["server " + payload["server"], "zone lylat.space."]
    for name, kind in sorted(set(map(tuple, previous)) | set(desired)):
        lines.append("update delete " + name + " " + kind)
    for record in payload["rrsets"]:
        for data in record["data"]:
            lines.append("update add {} {} {} {}".format(
                record["name"], record["ttl"], record["type"], data))
    lines.extend(["send", "answer", "quit", ""])
    # The signed transaction is atomic within this zone. BIND increments its SOA serial.
    # Retry during container startup; never advance the ownership manifest on failure.
    for attempt in range(15):
        result = subprocess.run([
            "podman", "exec", "-i", "bind9", "nsupdate", "-v",
            "-k", "/etc/bind/tsig.key",
        ], input="\n".join(lines), text=True, capture_output=True)
        if result.returncode == 0:
            break
        if attempt == 14:
            raise RuntimeError("RFC 2136 update failed: " + result.stdout + result.stderr)
        time.sleep(2)
    fd, temporary = tempfile.mkstemp(dir=manifest.parent, prefix=".bind9-tofu-")
    try:
        with os.fdopen(fd, "w") as output:
            json.dump(desired, output)
        os.replace(temporary, manifest)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    print("RFC 2136 update complete: {} RRsets".format(len(desired)))
