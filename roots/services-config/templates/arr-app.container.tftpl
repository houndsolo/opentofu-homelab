# Managed by OpenTofu (services-config, arr.tf). Local edits are overwritten.
# ${description}
[Unit]
Description=${description}
RequiresMountsFor=/data

[Container]
Image=${image}
ContainerName=${name}
Pod=arr.pod
%{ if user != "" ~}
User=${user}
Group=${user}
%{ endif ~}
%{ for k, v in env ~}
Environment=${k}=${v}
%{ endfor ~}
%{ for v in volumes ~}
Volume=${v}
%{ endfor ~}
HealthCmd=${health}
HealthInterval=30s
HealthTimeout=30s
HealthStartPeriod=5m
Notify=healthy

[Service]
Restart=always
# First start of a new version migrates the app's database.
TimeoutStartSec=900
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
