#!/bin/bash
# Nextcloud deploy (services-config nextcloud.tf): CephFS mount, host config, the Quadlet pod
# (app + web + session proxy), the first install (canary only), cron (one node). Fails, without touching the
# other nodes, unless this node serves status.php as installed and not in maintenance.
set -euo pipefail
umask 077
command -v podman >/dev/null
stage=$(mktemp -d /tmp/tofu-nextcloud.XXXXXX)
trap 'rm -rf "$stage"' EXIT
export DEBIAN_FRONTEND=noninteractive
host=$(hostname -s)

for img in '${app_image}' '${web_image}'%{ if shared_sessions } '${haproxy_image}'%{ endif }; do
  podman image exists "$img" || podman pull -q "$img" >/dev/null
done

# --- CephFS /nextcloud at /var/lib/nextcloud (kernel client; mount.ceph comes with ceph-common) ---
if ! command -v mount.ceph >/dev/null; then
  apt-get update -q
  apt-get install -y -q --no-install-recommends ceph-common
fi
install -d -m 0755 /etc/ceph /var/lib/nextcloud
printf '%s' '${cephfs_key_b64}' | base64 -d > "$stage/cephfs.secret"
install -m 0600 -o root -g root "$stage/cephfs.secret" /etc/ceph/${cephfs_client}.secret
printf '%s' '${mount_b64}' | base64 -d > "$stage/var-lib-nextcloud.mount"
if ! cmp -s "$stage/var-lib-nextcloud.mount" /etc/systemd/system/var-lib-nextcloud.mount; then
  install -m 0644 "$stage/var-lib-nextcloud.mount" /etc/systemd/system/var-lib-nextcloud.mount
  systemctl daemon-reload
  if mountpoint -q /var/lib/nextcloud; then systemctl restart var-lib-nextcloud.mount; fi
fi
systemctl enable --quiet var-lib-nextcloud.mount
systemctl start var-lib-nextcloud.mount
mountpoint -q /var/lib/nextcloud
echo "cephfs mounted at /var/lib/nextcloud"
# Shared dirs (the first node creates them). www-data in the image is uid/gid 33. Nextcloud wants 0770 on data.
for d in config custom_apps themes; do install -d -m 0750 -o 33 -g 33 /var/lib/nextcloud/$d; done
install -d -m 0770 -o 33 -g 33 /var/lib/nextcloud/data
# The code: local per node, filled by the image's entrypoint.
install -d -m 0755 /var/lib/nextcloud-html

# --- Host config (/etc/nextcloud is root-only; the files inside are read by the containers) ---
install -d -m 0700 /etc/nextcloud
install -d -m 0755 /etc/nextcloud/nginx /etc/nextcloud/haproxy /etc/containers/systemd
printf '%s' '${php_b64}' | base64 -d > "$stage/php.ini"
printf '%s' '${fpm_b64}' | base64 -d > "$stage/fpm.conf"
printf '%s' '${nginx_b64}' | base64 -d > "$stage/nginx.conf"
printf '%s' '${pod_b64}' | base64 -d > "$stage/nextcloud.pod"
printf '%s' '${app_b64}' | base64 -d > "$stage/nextcloud-app.container"
printf '%s' '${web_b64}' | base64 -d > "$stage/nextcloud-web.container"
changed=0
cmp -s "$stage/php.ini" /etc/nextcloud/php.ini || changed=1
cmp -s "$stage/fpm.conf" /etc/nextcloud/fpm.conf || changed=1
cmp -s "$stage/nginx.conf" /etc/nextcloud/nginx/nginx.conf || changed=1
for u in nextcloud.pod nextcloud-app.container nextcloud-web.container; do
  cmp -s "$stage/$u" /etc/containers/systemd/$u || changed=1
done
# php.ini holds the Valkey password (session.save_path): 0644 because php-cli (occ) runs as www-data in the
# container and must read it too; /etc/nextcloud itself is 0700, so other host users can't.
install -m 0644 -o root -g root "$stage/php.ini" /etc/nextcloud/php.ini
install -m 0644 -o root -g root "$stage/fpm.conf" /etc/nextcloud/fpm.conf
install -m 0644 -o root -g root "$stage/nginx.conf" /etc/nextcloud/nginx/nginx.conf
podman run --rm --network none --entrypoint nginx -v /etc/nextcloud/nginx:/etc/nextcloud-nginx:ro '${web_image}' -c /etc/nextcloud-nginx/nginx.conf -t -q
%{ if shared_sessions ~}
printf '%s' '${haproxy_b64}' | base64 -d > "$stage/haproxy.cfg"
printf '%s' '${haproxy_env_b64}' | base64 -d > "$stage/haproxy.env"
printf '%s' '${haproxy_unit_b64}' | base64 -d > "$stage/nextcloud-haproxy.container"
cmp -s "$stage/haproxy.cfg" /etc/nextcloud/haproxy/haproxy.cfg || changed=1
cmp -s "$stage/haproxy.env" /etc/nextcloud/haproxy.env || changed=1
cmp -s "$stage/nextcloud-haproxy.container" /etc/containers/systemd/nextcloud-haproxy.container || changed=1
install -m 0644 -o root -g root "$stage/haproxy.cfg" /etc/nextcloud/haproxy/haproxy.cfg
install -m 0600 -o root -g root "$stage/haproxy.env" /etc/nextcloud/haproxy.env
podman run --rm --network none --env-file /etc/nextcloud/haproxy.env -v /etc/nextcloud/haproxy:/usr/local/etc/haproxy:ro '${haproxy_image}' haproxy -c -q -f /usr/local/etc/haproxy/haproxy.cfg
units="nextcloud-app nextcloud-haproxy nextcloud-web"
%{ else ~}
# Session files per node (nextcloud.sessions = "local"): no session proxy.
if [ -e /etc/containers/systemd/nextcloud-haproxy.container ]; then
  systemctl stop nextcloud-haproxy.service || true
  rm -f /etc/containers/systemd/nextcloud-haproxy.container /etc/nextcloud/haproxy.env /etc/nextcloud/haproxy/haproxy.cfg
  changed=1
  echo "session proxy removed"
fi
units="nextcloud-app nextcloud-web"
%{ endif ~}
for u in nextcloud.pod nextcloud-app.container nextcloud-web.container%{ if shared_sessions } nextcloud-haproxy.container%{ endif }; do
  install -m 0644 -o root -g root "$stage/$u" /etc/containers/systemd/$u
done

# Shared Nextcloud config (same content from every node): written atomically, Nextcloud reads it per request.
printf '%s' '${config_b64}' | base64 -d > "$stage/lylat.config.php"
if ! cmp -s "$stage/lylat.config.php" /var/lib/nextcloud/config/lylat.config.php; then
  install -m 0640 -o 33 -g 33 "$stage/lylat.config.php" "/var/lib/nextcloud/config/.lylat.config.php.$host"
  mv -f "/var/lib/nextcloud/config/.lylat.config.php.$host" /var/lib/nextcloud/config/lylat.config.php
  echo "shared config updated"
fi

# --- Start or restart the pod (only when something changed or it isn't running) ---
running=1
for u in $units; do systemctl is-active --quiet $u.service || running=0; done
if [ $changed -eq 1 ] || [ $running -eq 0 ]; then
  systemctl daemon-reload
  systemctl stop $units nextcloud-pod.service 2>/dev/null || true
  systemctl start nextcloud-pod.service
  for u in $units; do systemctl start $u.service; done
  echo "nextcloud pod restarted"
else
  echo "nextcloud pod unchanged, not restarted"
fi

# status.php through this node's nginx: 200 once php-fpm runs (installed or not). The first start copies the
# code and an upgrade runs occ upgrade first: allow 20 minutes.
status=""
for i in $(seq 1 240); do
  status=$(curl -sf --max-time 5 -H 'Host: ${domain}' 'http://${listen}:${port}/status.php' || true)
  case "$status" in *'"installed"'*) break ;; esac
  sleep 5
done
case "$status" in
  *'"installed"'*) ;;
  *) echo "nextcloud doesn't answer on http://${listen}:${port}/status.php" >&2; journalctl -u nextcloud-app.service -n 40 --no-pager >&2; exit 1 ;;
esac

occ() { podman exec -u www-data nextcloud-app php -f /var/www/html/occ "$@"; }

case "$status" in
  *'"installed":false'*)
%{ if install_node ~}
    # First install (canary only): Postgres database/role from monitoring-config, admin from tofu.
    # Credentials go in through an env file, never the command line on the host.
    printf '%s' '${install_env_b64}' | base64 -d > "$stage/install.env"
    podman exec --env-file "$stage/install.env" -u www-data nextcloud-app sh -c 'php -f /var/www/html/occ maintenance:install -n \
      --database pgsql --database-host "$NC_DB_HOST" --database-name "$NC_DB_NAME" \
      --database-user "$NC_DB_USER" --database-pass "$NC_DB_PASS" \
      --admin-user "$NC_ADMIN_USER" --admin-pass "$NC_ADMIN_PASS" --data-dir /var/www/html/data'
    rm -f "$stage/install.env"
    echo "nextcloud installed"
%{ else ~}
    echo "nextcloud isn't installed yet: the first node by name installs it (deploy it first)" >&2
    exit 1
%{ endif ~}
    ;;
esac

# Healthy = installed, not in maintenance, no pending database upgrade.
status=$(curl -sf --max-time 5 -H 'Host: ${domain}' 'http://${listen}:${port}/status.php' || true)
case "$status" in
  *'"installed":true'*'"maintenance":false'*'"needsDbUpgrade":false'*) echo "nextcloud is healthy on ${listen} ($status)" ;;
  *) echo "nextcloud is not healthy on ${listen}: $status" >&2; journalctl -u nextcloud-app.service -n 40 --no-pager >&2; exit 1 ;;
esac
%{ if shared_sessions ~}

# Sessions: the local HAProxy must reach a Valkey primary (role:master). The password stays inside
# the container (read from session.save_path).
role=$(podman exec nextcloud-app php -r 'parse_str(parse_url(ini_get("session.save_path"), PHP_URL_QUERY), $q); $r = new Redis(); $r->connect("127.0.0.1", 6379, 2); $r->auth($q["auth"]); echo $r->info("replication")["role"];' 2>/dev/null || true)
if [ "$role" != master ]; then
  echo "the session proxy doesn't reach the Valkey primary (role: '$role')" >&2
  journalctl -u nextcloud-haproxy.service -n 20 --no-pager >&2
  exit 1
fi
echo "sessions: HAProxy reaches the Valkey primary"
%{ endif ~}

# --- Background jobs: cron mode, cron.php from a timer on one node only ---
%{ if cron ~}
printf '%s' '${cron_service_b64}' | base64 -d > "$stage/nextcloud-cron.service"
printf '%s' '${cron_timer_b64}' | base64 -d > "$stage/nextcloud-cron.timer"
install -m 0644 "$stage/nextcloud-cron.service" /etc/systemd/system/nextcloud-cron.service
install -m 0644 "$stage/nextcloud-cron.timer" /etc/systemd/system/nextcloud-cron.timer
systemctl daemon-reload
systemctl enable --now --quiet nextcloud-cron.timer
occ background:cron >/dev/null
echo "cron: nextcloud-cron.timer runs cron.php on $host"
%{ else ~}
if [ -e /etc/systemd/system/nextcloud-cron.timer ]; then
  systemctl disable --now --quiet nextcloud-cron.timer || true
  rm -f /etc/systemd/system/nextcloud-cron.timer /etc/systemd/system/nextcloud-cron.service
  systemctl daemon-reload
  echo "cron: timer removed (another node runs cron.php)"
fi
%{ endif ~}
