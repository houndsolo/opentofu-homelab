; Managed by OpenTofu (services-config, forgejo.tf). Local edits are overwritten.
; Forgejo, active/passive: one database, Valkey for sessions, cache and queues, shared storage for repositories
; and data (CephFS /forgejo), the "db" issue indexer (bleve can't be shared), code search off (it would need
; Elasticsearch), logs to the console (the journal) per node. Paths are the rootless image's (/var/lib/gitea).
APP_NAME  = ${app_name}
RUN_MODE  = prod
RUN_USER  = git
WORK_PATH = /var/lib/gitea

[server]
PROTOCOL               = http
HTTP_ADDR              = 0.0.0.0
HTTP_PORT              = 3000
DOMAIN                 = ${domain}
ROOT_URL               = https://${domain}/
APP_DATA_PATH          = /var/lib/gitea/data
DISABLE_SSH            = false
START_SSH_SERVER       = true
SSH_DOMAIN             = ${domain}
SSH_PORT               = ${ssh_port}
SSH_LISTEN_HOST        = 0.0.0.0
SSH_LISTEN_PORT        = 2222
; The host keys the old Gitea generated on this share (ed25519 first): clients' known_hosts stay valid.
; Forgejo's default list is RSA only.
SSH_SERVER_HOST_KEYS   = ssh/gitea.ed25519, ssh/gitea.ecdsa, ssh/gitea.rsa
LFS_START_SERVER       = true
LFS_JWT_SECRET         = ${lfs_jwt_secret}
; No external CDNs; also turns Gravatar off by default (the avatar settings live in the admin panel).
OFFLINE_MODE           = true

[database]
DB_TYPE  = postgres
HOST     = ${db_host}:${db_port}
NAME     = ${db_name}
USER     = ${db_user}
PASSWD   = `${db_password}`
SSL_MODE = require

[repository]
ROOT = /var/lib/gitea/git/repositories

[lfs]
PATH = /var/lib/gitea/git/lfs

[session]
PROVIDER        = redis
PROVIDER_CONFIG = ${valkey}/${session_db}?mastername=${master_name}
COOKIE_SECURE   = true

[cache]
ADAPTER = redis
HOST    = ${valkey}/${cache_db}?mastername=${master_name}

[queue]
TYPE     = redis
CONN_STR = ${valkey}/${queue_db}?mastername=${master_name}

[indexer]
ISSUE_INDEXER_TYPE   = db
REPO_INDEXER_ENABLED = false

[security]
INSTALL_LOCK                  = true
SECRET_KEY                    = ${secret_key}
INTERNAL_TOKEN                = ${internal_token}
REVERSE_PROXY_TRUSTED_PROXIES = ${trusted_proxies}

[oauth2]
JWT_SECRET = ${oauth2_jwt_secret}

[service]
DISABLE_REGISTRATION = ${disable_registration}
REQUIRE_SIGNIN_VIEW  = ${require_signin_view}

[mailer]
ENABLED = false

[log]
MODE  = console
LEVEL = info
%{ if standby ~}

; Hot standby (the proxy's backup server): no scheduled tasks here, the primary runs them once (Forgejo has
; no global lock between nodes).
[cron]
ENABLED = false
%{ for t in cron_tasks ~}

[cron.${t}]
ENABLED = false
%{ endfor ~}
%{ endif ~}
