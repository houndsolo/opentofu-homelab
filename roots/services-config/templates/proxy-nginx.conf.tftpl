# Managed by OpenTofu (services-config, proxy.tf). Local edits are overwritten.
# Complete nginx.conf for the nginx container (Quadlet nginx.container, host network): TLS reverse
# proxy for <name>.${domain}, one server block per published host (its name plus aliases), upstreams
# are the services' own VIPs over HTTP, every VM of a role over HTTP (active/active apps: nextcloud), or the
# Proxmox nodes' :8006 over HTTPS (pve, pve-<node>); plain TCP forwards in the stream block at the end. IPv4 only (the proxies have no global IPv6 address).
# Logs: the image links /var/log/nginx/*.log to stdout/stderr, so they land in the journal (and Loki).

user  nginx;
worker_processes auto;
pid   /run/nginx.pid;
error_log /var/log/nginx/error.log notice;

events {
  worker_connections 1024;
}

http {
  include      /etc/nginx/mime.types;
  default_type application/octet-stream;
  # Access log in logfmt, one line per request: the nginx dashboard parses it in Loki with `| logfmt`
  # (vhost, status, upstream time per site). vhost, not host: Loki's stream label host is the proxy VM.
  log_format lylat 'vhost=$host status=$status method=$request_method uri="$uri" proto=$server_protocol '
                   'bytes=$body_bytes_sent rt=$request_time urt="$upstream_response_time" '
                   'ustatus="$upstream_status" upstream="$upstream_addr" client=$remote_addr '
                   'tls=$ssl_protocol ua="$http_user_agent"';
  access_log   /var/log/nginx/access.log lylat;
  sendfile     on;
  keepalive_timeout 65;
  server_tokens off;

  map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
  }

  # Let's Encrypt wildcard from roots/certs (renewals reload nginx). nginx's defaults already are
  # ssl_protocols TLSv1.2 TLSv1.3 and ssl_prefer_server_ciphers off.
  ssl_certificate     ${cert_dir}/fullchain.pem;
  ssl_certificate_key ${cert_dir}/privkey.pem;
  ssl_session_cache   shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

%{ for name, h in hosts ~}
%{ if length(h.servers) > 0 ~}
  # ${h.names[0]}: ${h.backend}.
  upstream ${replace(name, "-", "_")} {
%{ if h.balance != "" ~}
    ${h.balance};
%{ endif ~}
%{ for s in h.servers ~}
    server ${s} max_fails=1 fail_timeout=30s;
%{ endfor ~}
  }

%{ endif ~}
%{ endfor ~}
  # Port 80: health check for keepalived/monitoring, everything else to HTTPS. /healthz also reports
  # the config id, so a deploy can tell when a reload has reached every worker.
  server {
    listen 80 default_server;
    server_name _;

    location = /healthz {
      access_log off;
      default_type text/plain;
      return 200 "ok ${config_id}\n";
    }

    # Connection/request counters for the nginx-prometheus-exporter on this host (proxy-monitoring.tf).
    location = /nginx_status {
      stub_status;
      access_log off;
      allow 127.0.0.1;
      deny all;
    }

    location / {
      return 301 https://$host$request_uri;
    }
  }

%{ if length(landing_names) > 0 ~}
  # Landing page: index of the published hosts (generated by proxy.tf into ${conf_dir}/www).
  server {
    listen 443 ssl;
    http2 on;
    server_name ${join(" ", landing_names)};
    root ${conf_dir}/www;

    location / {
      try_files $uri /index.html;
      add_header Cache-Control "no-cache";
    }
  }

%{ endif ~}
  # HTTPS for names that aren't published (or no SNI, e.g. https://<VIP>/): 404.
  server {
    listen 443 ssl default_server;
    http2 on;
    server_name _;
    return 404;
  }
%{ for name, h in hosts }
  server {
    listen 443 ssl;
    http2 on;
    server_name ${join(" ", h.names)};

    client_max_body_size ${h.max_body};

    location / {
      proxy_pass ${h.upstream};
      proxy_http_version 1.1;
      proxy_set_header Host              $host;
      proxy_set_header X-Real-IP         $remote_addr;
      proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Host  $host;
%{ if h.websockets ~}
      proxy_set_header Upgrade           $http_upgrade;
      proxy_set_header Connection        $connection_upgrade;
%{ else ~}
      proxy_set_header Connection        "";
%{ endif ~}
%{ if h.tls ~}
      # Proxmox: self-signed pve-ssl certificates; a powered-off node (greatfox) fails within 3 s (502, or
      # the next cluster node); uploads stream to the node; consoles stay open for an hour of idle.
      proxy_ssl_verify        off;
      proxy_connect_timeout   3s;
      proxy_request_buffering off;
      proxy_buffering         off;
      proxy_read_timeout 3600s;
%{ else ~}
%{ if h.tls_name != null ~}
      # HTTPS to the nodes, certificate verified for ${h.tls_name} (OpenBao).
      proxy_ssl_verify               on;
      proxy_ssl_name                 ${h.tls_name};
      proxy_ssl_server_name          on;
      proxy_ssl_trusted_certificate  /etc/ssl/certs/ca-certificates.crt;
      proxy_ssl_verify_depth         3;
%{ endif ~}
%{ if length(h.servers) > 0 ~}
      # Several nodes: give up on a dead one within 1 s and try the next (the deploy's 5 s health check).
      proxy_connect_timeout 1s;
%{ endif ~}
%{ if h.stream ~}
      # Big uploads/downloads stream through instead of being buffered on the proxy's disk.
      proxy_request_buffering off;
      proxy_buffering         off;
      proxy_read_timeout 3600s;
      proxy_send_timeout 3600s;
%{ else ~}
      proxy_read_timeout 300s;
%{ endif ~}
%{ endif ~}
    }
  }
%{ endfor ~}
}
%{ if length(tcp) > 0 }
# Plain TCP forwards (var.proxy.tcp): every VM of a role, like the role hosts above. One logfmt line per connection.
stream {
  log_format lylat_tcp 'stream=$server_port status=$status bytes_in=$bytes_received bytes_out=$bytes_sent '
                       'session=$session_time upstream="$upstream_addr" client=$remote_addr';
  access_log /var/log/nginx/access.log lylat_tcp;
%{ for name, t in tcp }
  # ${name}: ${t.backend}.
  upstream tcp_${replace(name, "-", "_")} {
%{ for srv in t.servers ~}
    server ${srv} max_fails=1 fail_timeout=30s;
%{ endfor ~}
  }

  server {
    listen ${t.port};
    proxy_pass tcp_${replace(name, "-", "_")};
    # A dead node is skipped within 1 s; an idle git session may stay open for an hour.
    proxy_connect_timeout 1s;
    proxy_timeout 1h;
  }
%{ endfor ~}
}
%{ endif ~}
