# Managed by OpenTofu (services-config, proxy.tf). Local edits are overwritten.
# TLS reverse proxy for <name>.${domain}: one server block per published host (its name plus
# aliases), upstreams are the services' own VIPs over HTTP.
# IPv4 only (the proxies have no global IPv6 address).

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# Let's Encrypt wildcard from roots/certs (renewals reload nginx). Debian's nginx.conf already sets
# server_tokens off, ssl_protocols TLSv1.2 TLSv1.3 and ssl_prefer_server_ciphers off.
ssl_certificate     ${cert_dir}/fullchain.pem;
ssl_certificate_key ${cert_dir}/privkey.pem;
ssl_session_cache   shared:SSL:10m;
ssl_session_timeout 1d;
ssl_session_tickets off;

# Port 80: health check for keepalived/monitoring, everything else to HTTPS. /healthz also reports
# the config id, so a deploy can tell when a reload has reached every worker.
server {
  listen 80 default_server;
  server_name _;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok ${config_id}\n";
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

# HTTPS for names that aren't published (or no SNI, e.g. https://<VIP>/): 404.
server {
  listen 443 ssl default_server;
  http2 on;
  server_name _;
  return 404;
}
%{ for name, h in hosts }
server {
  listen 443 ssl;
  http2 on;
  server_name ${join(" ", h.names)};

  client_max_body_size ${h.max_body};

  location / {
    proxy_pass ${h.upstream};
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host  $host;
%{ if h.websockets ~}
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;
%{ else ~}
    proxy_set_header Connection        "";
%{ endif ~}
    proxy_read_timeout 300s;
  }
}
%{ endfor ~}
