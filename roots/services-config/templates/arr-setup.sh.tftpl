#!/bin/bash
# Managed by OpenTofu (services-config, arr.tf): first-time wiring of the arr stack, run by every deploy after
# the apps are healthy. Each step runs ONCE (marker file in /var/lib/arr/setup/), so later changes made in the
# web UIs are never overwritten. Delete a marker to re-run its step on the next deploy.
set -euo pipefail
M=/var/lib/arr/setup
mkdir -p $M
# This script runs on the VM: the pod publishes the apps on ${host} only. Inside the pod (Prowlarr -> Sonarr)
# the apps reach each other on 127.0.0.1.
H='${host}'
ADMIN_USER='${admin_user}'
ADMIN_PASS='${admin_password}'
declare -A KEY=([sonarr]='${sonarr_key}' [radarr]='${radarr_key}' [prowlarr]='${prowlarr_key}')
declare -A PORT=([sonarr]=8989 [radarr]=7878 [prowlarr]=9696)
declare -A API=([sonarr]=v3 [radarr]=v3 [prowlarr]=v1)
declare -A ROOT=([sonarr]='/data/library/tv /data/library/anime' [radarr]='/data/library/movies /data/library/anime-movies')

# Library folders on CephFS (owned by the media uid, group-writable; mkdir -p is a no-op once they exist).
for d in /data/library/tv /data/library/movies /data/library/anime /data/library/anime-movies; do
  [ -d "$d" ] || { install -d -m 2775 -o ${uid} -g ${uid} "$d"; echo "arr-setup: created $d"; }
done

once() { [ -e "$M/$1" ]; }
done_() { touch "$M/$1"; echo "arr-setup: $1 done"; }
api() { # app method path [json]
  local app=$1 m=$2 p=$3
  curl -fsS --max-time 30 -X "$m" -H "X-Api-Key: $${KEY[$app]}" -H 'Content-Type: application/json' \
    "http://$H:$${PORT[$app]}/api/$${API[$app]}$p" $${4:+--data "$4"}
}

# 1. Sonarr, Radarr, Prowlarr: forms login (user + password from tofu), the API key is pinned by the unit's env.
for app in sonarr radarr prowlarr; do
  once "$app-auth" && continue
  api $app GET /config/host | jq --arg u "$ADMIN_USER" --arg p "$ADMIN_PASS" \
    '.authenticationMethod="forms" | .authenticationRequired="enabled" | .username=$u | .password=$p | .passwordConfirmation=$p' \
    > $M/.host.json
  api $app PUT /config/host "$(cat $M/.host.json)" > /dev/null
  rm -f $M/.host.json
  done_ "$app-auth"
done

# 2. Root folders (the library on CephFS): tv/movies, and anime/anime-movies (series type Anime in Sonarr).
for app in sonarr radarr; do
  for root in $${ROOT[$app]}; do
    marker="$app-rootfolder-$(basename "$root")"
    [ "$root" = /data/library/tv ] || [ "$root" = /data/library/movies ] && marker="$app-rootfolder"
    once "$marker" && continue
    if ! api $app GET /rootfolder | jq -e --arg p "$root" 'any(.[]; .path == $p or .path == ($p + "/"))' > /dev/null; then
      api $app POST /rootfolder "$(jq -n --arg p "$root" '{path: $p}')" > /dev/null
    fi
    done_ "$marker"
  done
done

# 3. Prowlarr pushes its indexers to Sonarr and Radarr (Settings -> Apps).
for app in sonarr radarr; do
  once "prowlarr-app-$app" && continue
  name=$${app^}
  if ! api prowlarr GET /applications | jq -e --arg n "$name" 'any(.[]; .name == $n)' > /dev/null; then
    api prowlarr GET /applications/schema | jq --arg n "$name" --arg url "http://127.0.0.1:$${PORT[$app]}" --arg key "$${KEY[$app]}" '
      first(.[] | select(.implementation == $n)) | .name = $n | .syncLevel = "fullSync" |
      .fields |= map(if .name == "prowlarrUrl" then .value = "http://127.0.0.1:9696"
                     elif .name == "baseUrl" then .value = $url
                     elif .name == "apiKey" then .value = $key else . end)' > $M/.app.json
    api prowlarr POST /applications "$(cat $M/.app.json)" > /dev/null
    rm -f $M/.app.json
  fi
  done_ "prowlarr-app-$app"
done

# 4. Bazarr: login, and its links to Sonarr and Radarr (it reads their libraries and fetches subtitles).
if ! once bazarr-config; then
  BK=$(sed -n '/^auth:/,/^[a-z]/s/^  apikey: *//p' /var/lib/arr/bazarr/config/config.yaml | tr -d "'\"")
  [ -n "$BK" ] || { echo "arr-setup: bazarr API key not found"; exit 1; }
  curl -fsS --max-time 30 -o /dev/null -H "X-API-KEY: $BK" -X POST http://$H:6767/api/system/settings \
    --data-urlencode "settings-auth-type=form" --data-urlencode "settings-auth-username=$ADMIN_USER" \
    --data-urlencode "settings-auth-password=$ADMIN_PASS" \
    --data-urlencode "settings-general-use_sonarr=true" --data-urlencode "settings-sonarr-ip=127.0.0.1" \
    --data-urlencode "settings-sonarr-port=8989" --data-urlencode "settings-sonarr-apikey=$${KEY[sonarr]}" \
    --data-urlencode "settings-general-use_radarr=true" --data-urlencode "settings-radarr-ip=127.0.0.1" \
    --data-urlencode "settings-radarr-port=7878" --data-urlencode "settings-radarr-apikey=$${KEY[radarr]}"
  done_ bazarr-config
fi

# 5. Jellyfin: the startup wizard (admin user), then the two libraries.
JF=http://$H:8096
JH='MediaBrowser Client="tofu", Device="arr-setup", DeviceId="arr-setup", Version="1"'
if ! once jellyfin-wizard; then
  if [ "$(curl -fsS $JF/System/Info/Public | jq -r '.StartupWizardCompleted')" != true ]; then
    curl -fsS -o /dev/null -H "Authorization: $JH" -H 'Content-Type: application/json' -X POST $JF/Startup/Configuration \
      --data '{"UICulture":"en-US","MetadataCountryCode":"US","PreferredMetadataLanguage":"en"}'
    curl -fsS -o /dev/null -H "Authorization: $JH" $JF/Startup/User
    curl -fsS -o /dev/null -H "Authorization: $JH" -H 'Content-Type: application/json' -X POST $JF/Startup/User \
      --data "$(jq -n --arg u "$ADMIN_USER" --arg p "$ADMIN_PASS" '{Name: $u, Password: $p}')"
    curl -fsS -o /dev/null -H "Authorization: $JH" -H 'Content-Type: application/json' -X POST $JF/Startup/RemoteAccess \
      --data '{"EnableRemoteAccess":true,"EnableAutomaticPortMapping":false}'
    curl -fsS -o /dev/null -H "Authorization: $JH" -X POST $JF/Startup/Complete
  fi
  done_ jellyfin-wizard
fi
jf_libraries() { # marker, then "Name|type|path" entries
  local marker=$1; shift
  once "$marker" && return 0
  TOKEN=$(curl -fsS -H "Authorization: $JH" -H 'Content-Type: application/json' -X POST $JF/Users/AuthenticateByName \
    --data "$(jq -n --arg u "$ADMIN_USER" --arg p "$ADMIN_PASS" '{Username: $u, Pw: $p}')" | jq -r .AccessToken) || TOKEN=
  # Never write the marker without a token: a password changed in the UI used to skip the anime libraries silently.
  [ -n "$TOKEN" ] && [ "$TOKEN" != null ] || { echo "arr-setup: $marker FAILED: Jellyfin refused the admin login (password changed in the UI?)" >&2; return 1; }
  local A="$JH, Token=\"$TOKEN\"" existing name type path
  existing=$(curl -fsS -H "Authorization: $A" $JF/Library/VirtualFolders | jq -r '.[].Name')
  for lib in "$@"; do
    IFS='|' read -r name type path <<< "$lib"
    grep -qxF "$name" <<< "$existing" && continue
    curl -fsS -o /dev/null -H "Authorization: $A" -H 'Content-Type: application/json' -X POST \
      "$JF/Library/VirtualFolders?name=$(jq -rn --arg n "$name" '$n|@uri')&collectionType=$type&paths=$(jq -rn --arg p "$path" '$p|@uri')&refreshLibrary=true" \
      --data '{"LibraryOptions":{}}'
  done
  done_ "$marker"
}
jf_libraries jellyfin-libraries "TV Shows|tvshows|/data/library/tv" "Movies|movies|/data/library/movies"
jf_libraries jellyfin-anime-libraries "Anime|tvshows|/data/library/anime" "Anime Movies|movies|/data/library/anime-movies"
echo "arr-setup: ok"
