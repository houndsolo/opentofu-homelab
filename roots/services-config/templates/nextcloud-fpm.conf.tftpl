; Managed by OpenTofu (services-config, nextcloud.tf). Mounted into the app container as
; /usr/local/etc/php-fpm.d/zz-lylat.conf. The stock pool allows 5 workers (max_children), which stalls
; sync clients under any real load (Nextcloud server tuning docs).
[www]
pm = dynamic
pm.max_children = ${max_children}
pm.start_servers = ${max(2, floor(max_children / 4))}
pm.min_spare_servers = ${max(1, floor(max_children / 4))}
pm.max_spare_servers = ${max(2, floor(max_children / 2))}
; Recycle workers now and then (memory leaks in extensions).
pm.max_requests = 500
request_terminate_timeout = 3600
