#!/usr/sbin/nft -f
# Managed by OpenTofu (services-config, proxy.tf): HTTP/HTTPS only from the lab's networks.
# Everything else on this VM (ssh, VRRP, exporters) is untouched (own table).
table inet proxy
delete table inet proxy
table inet proxy {
  set clients {
    type ipv4_addr
    flags interval
    auto-merge
    elements = { 127.0.0.0/8, ${join(", ", clients)} }
  }
  chain input {
    type filter hook input priority filter - 5; policy accept;
    tcp dport { 80, 443 } ip saddr @clients accept
    tcp dport { 80, 443 } drop
  }
}
