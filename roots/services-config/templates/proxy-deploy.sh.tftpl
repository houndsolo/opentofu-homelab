#!/bin/bash
# Reverse proxy deploy (services-config proxy.tf): nginx as a Podman Quadlet container (pinned image,
# host network), nftables for 80/443 and (HA) keepalived. Fails, without touching the other nodes, if
# nginx isn't healthy. Replaces a Debian nginx package if one is installed (earlier design).
set -euo pipefail
umask 077
stage=$(mktemp -d /tmp/tofu-proxy.XXXXXX)
trap 'rm -rf "$stage"' EXIT

# The certificate comes from roots/certs; without it nginx can't start.
for f in '${cert_dir}/fullchain.pem' '${cert_dir}/privkey.pem'; do
  [ -s "$f" ] || { echo "missing $f: apply roots/certs first" >&2; exit 1; }
done

pkgs="podman nftables curl"
%{ if ha ~}
pkgs="$pkgs keepalived"
%{ endif ~}
missing=""
for p in $pkgs; do dpkg -s "$p" >/dev/null 2>&1 || missing="$missing $p"; done
if [ -n "$missing" ]; then
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -q
  apt-get install -y -q --no-install-recommends $missing
fi

# nftables: own table, loaded by its own unit (the distro nftables.service stays as it is).
printf '%s' '${nft_b64}' | base64 -d > "$stage/proxy.nft"
nft -c -f "$stage/proxy.nft"
install -m 0644 -o root -g root "$stage/proxy.nft" /etc/nftables-proxy.nft
cat > "$stage/proxy-nft.service" <<'UNIT'
[Unit]
Description=nftables rules for the reverse proxy (80/443)
Wants=network-pre.target
Before=network-pre.target nginx.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/nftables-proxy.nft
ExecStop=/usr/sbin/nft delete table inet proxy

[Install]
WantedBy=multi-user.target
UNIT
install -m 0644 "$stage/proxy-nft.service" /etc/systemd/system/proxy-nft.service
systemctl daemon-reload
systemctl enable --quiet proxy-nft.service
systemctl restart proxy-nft.service

# Image (pinned tag), config and Quadlet unit.
podman image exists '${image}' || podman pull -q '${image}' >/dev/null
mkdir -p "$stage/conf/www"
printf '%s' '${nginx_b64}' | base64 -d > "$stage/conf/nginx.conf"
printf '%s' '${index_b64}' | base64 -d > "$stage/conf/www/index.html"
printf '%s' '${unit_b64}' | base64 -d > "$stage/nginx.container"
# Test the new config with the same image in a throwaway network namespace before installing it.
if ! podman run --rm --network none --entrypoint nginx \
    -v "$stage/conf:${conf_dir}:ro" -v '${cert_dir}:${cert_dir}:ro' \
    '${image}' -c '${conf_dir}/nginx.conf' -t -q; then
  echo "nginx config test failed (${image}); nothing changed" >&2
  exit 1
fi

debian_nginx=0
dpkg -s nginx >/dev/null 2>&1 && debian_nginx=1
dpkg -s nginx-common >/dev/null 2>&1 && debian_nginx=1
conf_changed=0
cmp -s "$stage/conf/nginx.conf" '${conf_dir}/nginx.conf' || conf_changed=1
restart=0
cmp -s "$stage/nginx.container" /etc/containers/systemd/nginx.container || restart=1
[ $debian_nginx -eq 1 ] && restart=1
systemctl is-active --quiet nginx.service || restart=1

%{ if ha ~}
# Restarting nginx on the node that holds the VIP: hand the VIP to a healthy peer first (stopping
# keepalived sends a priority-0 advert, the peer takes over within ~1 s) instead of failing the health
# check for ~9 s. The keepalived step below starts it again (BACKUP, nopreempt).
if [ $restart -eq 1 ] && systemctl is-active --quiet keepalived.service && ip -4 -o addr show | grep -q ' ${vip_address}/'; then
  peer_ok=0
%{ for p in peers ~}
  curl -sf -o /dev/null --max-time 2 'http://${p}/healthz' && peer_ok=1
%{ endfor ~}
  if [ $peer_ok -eq 1 ]; then
    systemctl stop keepalived.service
    for i in $(seq 1 20); do ip -4 -o addr show | grep -q ' ${vip_address}/' || break; sleep 0.25; done
    echo "VIP ${vip_address} handed to the peer before restarting nginx"
  else
    echo "no healthy peer: restarting nginx while holding the VIP" >&2
  fi
fi
%{ endif ~}

if [ $debian_nginx -eq 1 ]; then
  systemctl disable --now nginx.service 2>/dev/null || true
  export DEBIAN_FRONTEND=noninteractive
  apt-get purge -y -q nginx nginx-common >/dev/null
  echo "Debian nginx package removed"
fi
install -d -m 0755 -o root -g root '${conf_dir}' /etc/containers/systemd
install -m 0644 -o root -g root "$stage/conf/nginx.conf" '${conf_dir}/nginx.conf'
# Landing page (static: served without a reload).
install -d -m 0755 -o root -g root '${conf_dir}/www'
install -m 0644 -o root -g root "$stage/conf/www/index.html" '${conf_dir}/www/index.html'
install -m 0644 -o root -g root "$stage/nginx.container" /etc/containers/systemd/nginx.container
systemctl daemon-reload
if [ $restart -eq 1 ]; then
  systemctl restart nginx.service; echo "nginx (container) restarted"
elif [ $conf_changed -eq 1 ]; then
  systemctl reload nginx.service; echo "nginx reloaded"
else
  echo "nginx unchanged"
fi

# A reload is graceful: old workers keep answering for a moment. Wait until /healthz reports this
# config's id (two answers in a row) before checking the names.
healthy=0; seen=0; got=""
for i in $(seq 1 60); do
  got=$(curl -sf --max-time 2 http://127.0.0.1/healthz || true)
  if [ "$got" = "ok ${config_id}" ]; then seen=$((seen + 1)); else seen=0; fi
  if [ $seen -ge 2 ]; then healthy=1; break; fi
  sleep 0.5
done
if [ $healthy -ne 1 ]; then
  echo "nginx does not serve config ${config_id} (http://127.0.0.1/healthz: '$got')" >&2
  journalctl -u nginx.service -n 30 --no-pager >&2
  exit 1
fi
# Every published name must answer over TLS on this node (any HTTP status: the upstream decides).
%{ for h in host_names ~}
code=$(curl -s -o /dev/null -w '%%{http_code}' --max-time 5 --resolve '${h}:443:${listen}' 'https://${h}/' || true)
if [ "$${code:-000}" = 000 ]; then echo "https://${h}/ on ${listen}: no TLS/HTTP answer" >&2; exit 1; fi
echo "https://${h}/ on ${listen}: HTTP $code"
%{ endfor ~}

%{ if ha ~}
printf '%s' '${keepalived_b64}' | base64 -d > "$stage/keepalived.conf"
printf '%s' '${check_b64}' | base64 -d > "$stage/chk_proxy.sh"
install -d -m 0755 /etc/keepalived
# enable_script_security: the check must be root-owned and not writable by others.
install -m 0755 -o root -g root "$stage/chk_proxy.sh" /etc/keepalived/chk_proxy.sh
keepalived -t -f "$stage/keepalived.conf"
install -m 0600 -o root -g root "$stage/keepalived.conf" /etc/keepalived/keepalived.conf
systemctl enable --quiet keepalived.service
# Reload keeps the VRRP state (no VIP move); start only when not running yet.
if systemctl is-active --quiet keepalived.service; then systemctl reload keepalived.service; else systemctl start keepalived.service; fi
systemctl is-active --quiet keepalived.service
echo "keepalived running"
%{ endif ~}
