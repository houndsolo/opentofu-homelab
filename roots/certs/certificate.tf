# One ACME account and one wildcard certificate. The account key is generated by the provider
# (ECDSA P-256) and, like the certificate key, lives only in the encrypted state.
resource "acme_registration" "letsencrypt" {
  account_key_algorithm   = "ECDSA"
  account_key_ecdsa_curve = "P256"
  # No email: Let's Encrypt no longer sends expiry mails; the expiry alert lives in Grafana.
}

resource "acme_certificate" "svc" {
  account_key_pem = acme_registration.letsencrypt.account_key_pem
  common_name     = var.certificate.common_name
  key_type        = var.certificate.key_type

  # Renewal: Let's Encrypt's renewal window (ARI) when it publishes one, else when a third of the
  # lifetime is left (90-day certs now, 64 days from 2027-02-10, 45 days from 2028-02-16). Only
  # checked during plan/apply, hence the daily scheduled apply.
  use_renewal_info = true
  min_days_dynamic = true

  # Split horizon: a0-nix resolves lylat.space via dns01/dns02, which are authoritative for the
  # internal zone and never see Cloudflare's _acme-challenge TXT, so check propagation against
  # public resolvers (they lead to the Cloudflare nameservers).
  recursive_nameservers = ["1.1.1.1:53", "1.0.0.1:53"]

  dns_challenge {
    provider = "cloudflare"
    config = {
      CF_DNS_API_TOKEN = var.cloudflare["lylat.space"].api_token
    }
  }

  # A replaced certificate is still installed on the proxies until the deploy below finishes, and
  # its key is not compromised, so don't revoke it. Revoke by hand if a key ever leaks.
  revoke_certificate_on_destroy = false
}
