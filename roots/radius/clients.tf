# RADIUS clients -> /etc/radius/clients.conf on every radius VM, canary first. Their secrets (+ the server list)
# are also written to a git-ignored tfvars file that the device roots link (fabric-leaves for the VyOS leaves).
locals {
  leaf_clients = !var.inventory_clients.vyos_leaves ? {} : {
    for name, leaf in module.leaves.leaves : "leaf-${leaf.id}" => {
      address                       = leaf.management_ip
      nas_type                      = "other"
      require_message_authenticator = null
    }
  }
  all_clients = merge(local.leaf_clients, var.clients)
}

resource "random_password" "client" {
  for_each = local.all_clients
  length   = 32
  special  = false
}

locals {
  clients_conf = templatefile("${path.module}/templates/clients.conf.tftpl", {
    clients = { for n, c in local.all_clients : n => merge(c, { secret = random_password.client[n].result }) }
  })
  clients_script = templatefile("${path.module}/templates/clients-deploy.sh.tftpl", {
    conf_b64 = base64encode(local.clients_conf)
    count    = length(local.all_clients)
  })
}

resource "terraform_data" "clients_canary" {
  for_each = local.canary == null ? {} : { (local.canary) = local.radius_vms[local.canary] }

  triggers_replace = [sha256(local.clients_script), each.value.management_address, each.value.vm_id]

  connection {
    type        = "ssh"
    host        = split("/", each.value.management_address)[0]
    user        = each.value.config.ssh_username
    private_key = file(pathexpand(var.ssh_private_key_path))
    timeout     = "5m"
  }

  provisioner "remote-exec" {
    inline = ["install -d -m 0700 /tmp/tofu-radius-clients-${self.id}"]
  }

  provisioner "file" {
    content     = local.clients_script
    destination = "/tmp/tofu-radius-clients-${self.id}/deploy.sh"
  }

  provisioner "remote-exec" {
    inline = ["rc=0; sudo -n bash /tmp/tofu-radius-clients-${self.id}/deploy.sh || rc=$?; rm -rf /tmp/tofu-radius-clients-${self.id}; exit $rc"]
  }
}

resource "terraform_data" "clients" {
  for_each   = { for n, vm in local.radius_vms : n => vm if n != local.canary }
  depends_on = [terraform_data.clients_canary]

  triggers_replace = [sha256(local.clients_script), each.value.management_address, each.value.vm_id]

  connection {
    type        = "ssh"
    host        = split("/", each.value.management_address)[0]
    user        = each.value.config.ssh_username
    private_key = file(pathexpand(var.ssh_private_key_path))
    timeout     = "5m"
  }

  provisioner "remote-exec" {
    inline = ["install -d -m 0700 /tmp/tofu-radius-clients-${self.id}"]
  }

  provisioner "file" {
    content     = local.clients_script
    destination = "/tmp/tofu-radius-clients-${self.id}/deploy.sh"
  }

  provisioner "remote-exec" {
    inline = ["rc=0; sudo -n bash /tmp/tofu-radius-clients-${self.id}/deploy.sh || rc=$?; rm -rf /tmp/tofu-radius-clients-${self.id}; exit $rc"]
  }
}

# For the device roots: servers + one secret per client, as a tfvars file in the git-ignored secret inventory.
# fabric-leaves links it as radius-clients.secret.auto.tfvars (variables radius_servers, radius_client_secrets).
resource "local_sensitive_file" "client_secrets" {
  filename        = "${path.module}/../../inventory/auto.tfvars.secret/radius-clients.secret.auto.tfvars"
  file_permission = "0600"
  content = join("\n", [
    "# Generated by roots/radius (clients.tf). Do not edit: the next apply of roots/radius rewrites it.",
    "radius_servers        = ${jsonencode([for n in local.radius_names : split("/", local.radius_vms[n].management_address)[0]])}",
    "radius_client_secrets = ${jsonencode({ for n in keys(local.all_clients) : n => random_password.client[n].result })}",
    "",
  ])
}
